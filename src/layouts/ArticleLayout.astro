---
import BaseLayout from './BaseLayout.astro';
import Badge from '../components/common/Badge.astro';
import TableOfContents from '../components/article/TableOfContents.astro';
import ConversionCTA from '../components/article/ConversionCTA.astro';
import RelatedPosts from '../components/article/RelatedPosts.astro';
import '../styles/typography.css';

interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date | string;
  updatedDate?: Date | string;
  category: string;
  tags?: string[];
  readTime?: string;
  author?: string;
  slug: string;
  headings?: HeadingItem[];
  toc?: boolean;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  category,
  tags = [],
  readTime = '8 分钟',
  author = 'ClashLab 实验室',
  slug,
  headings = [],
  toc = true,
} = Astro.props;

const formatDate = (d: Date | string) => {
  const date = new Date(d);
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
};

const formattedPubDate = formatDate(pubDate);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : null;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': '首页',
      'item': 'https://clashlab.blog/'
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': '文章知识库',
      'item': 'https://clashlab.blog/posts'
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': category,
      'item': `https://clashlab.blog/posts?category=${encodeURIComponent(category)}`
    },
    {
      '@type': 'ListItem',
      'position': 4,
      'name': title,
      'item': `https://clashlab.blog/posts/${slug}`
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishDate={new Date(pubDate).toISOString()}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <div class="article-page-wrapper">
    <!-- Breadcrumb Header -->
    <div class="article-hero-section">
      <div class="container">
        <!-- Breadcrumbs -->
        <nav class="breadcrumbs" aria-label="路径导航">
          <a href="/">首页</a>
          <span class="crumb-sep">/</span>
          <a href="/posts">文章</a>
          <span class="crumb-sep">/</span>
          <a href={`/posts?category=${encodeURIComponent(category)}`}>{category}</a>
          <span class="crumb-sep">/</span>
          <span class="crumb-current">正文</span>
        </nav>

        <!-- Article Header Info -->
        <header class="article-header">
          <div class="article-badge-row">
            <Badge variant="blue">{category}</Badge>
            {tags.slice(0, 2).map((t) => (
              <Badge variant="gray" size="sm">#{t}</Badge>
            ))}
          </div>

          <h1 class="article-main-title">{title}</h1>

          <p class="article-main-lead">{description}</p>

          <div class="article-meta-bar">
            <!-- Author -->
            <div class="author-info">
              <div class="author-avatar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </div>
              <div class="author-names">
                <span class="author-name">{author}</span>
                <span class="author-role">网络架构与安全研究</span>
              </div>
            </div>

            <!-- Meta details -->
            <div class="meta-details">
              <span class="meta-item" title="发布时间">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="meta-ico">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                发布于 {formattedPubDate}
              </span>

              {formattedUpdatedDate && (
                <span class="meta-item updated" title="最新校订">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="meta-ico">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                  </svg>
                  修订于 {formattedUpdatedDate}
                </span>
              )}

              <span class="meta-item" title="预计阅读时间">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="meta-ico">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                {readTime}
              </span>
            </div>
          </div>
        </header>
      </div>
    </div>

    <!-- 2-Column Main Content Container -->
    <div class="container article-layout-body">
      <div class="article-main-grid">
        <!-- Left: Article Content Body (780px max) -->
        <main class="article-content-column">
          <div class="prose article-prose" id="article-body">
            <slot />
          </div>

          <!-- Bottom Tags List -->
          {tags.length > 0 && (
            <div class="article-bottom-tags">
              <span class="tags-heading">本文关键词:</span>
              <div class="tags-cluster">
                {tags.map((tag) => (
                  <a href={`/posts?tag=${encodeURIComponent(tag)}`} class="tag-pill">
                    #{tag}
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Lab Disclaimer Box -->
          <div class="article-disclaimer-box">
            <div class="disclaimer-title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <span>实验测评说明与免责声明</span>
            </div>
            <p>
              本文基于实验室特定硬件环境及网络拓扑进行客观记录与测试，网络指标会随地域运营商、骨干网 QoS 波动而变化。所有内容仅供技术探索与合规网络研究。
            </p>
          </div>

          <!-- High-Conversion Bottom CTA -->
          <ConversionCTA />

          <!-- Related Posts Section -->
          <RelatedPosts currentSlug={slug} category={category} tags={tags} />
        </main>

        <!-- Right: Sticky Sidebar (TOC & Fast Tools) -->
        <aside class="article-sidebar-column">
          <div class="sticky-sidebar-inner">
            <!-- Table of Contents -->
            {toc && headings.length > 0 && (
              <TableOfContents headings={headings} />
            )}

            <!-- Quick Share & Copy Card -->
            <div class="sidebar-card quick-share-card">
              <h4 class="sidebar-card-title">分享与收藏</h4>
              <button id="copy-link-btn" class="btn btn-secondary btn-sm copy-btn" data-url={Astro.url.href}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span id="copy-text">复制文章链接</span>
              </button>
            </div>

            <!-- Mini Sidebar Tool CTA -->
            <div class="sidebar-card sidebar-tool-card">
              <div class="tool-card-icon">⚡</div>
              <h4 class="sidebar-card-title">在线订阅转换与格式校验</h4>
              <p class="tool-card-desc">支持 Clash / V2Ray / Sing-box / Surge 订阅规则一键转换。</p>
              <a href="/tools" class="btn btn-primary btn-sm">免费使用工具 →</a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .article-page-wrapper {
    background-color: var(--bg-main);
    padding-bottom: 4rem;
  }

  .article-hero-section {
    background: linear-gradient(180deg, var(--bg-subtle) 0%, var(--bg-main) 100%);
    border-bottom: 1px solid var(--border-light);
    padding-top: 1.75rem;
    padding-bottom: 2.25rem;
  }

  /* Breadcrumbs */
  .breadcrumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .crumb-sep {
    color: #CBD5E1;
  }

  .breadcrumbs a:hover {
    color: var(--primary);
  }

  .crumb-current {
    color: var(--text-main);
    font-weight: 500;
  }

  /* Article Header */
  .article-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 900px;
  }

  .article-badge-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .article-main-title {
    font-size: 1.85rem;
    font-weight: 800;
    line-height: 1.3;
    color: var(--text-main);
    letter-spacing: -0.025em;
  }

  @media (min-width: 768px) {
    .article-main-title {
      font-size: 2.25rem;
    }
  }

  .article-main-lead {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-body);
  }

  .article-meta-bar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1.25rem;
    margin-top: 0.5rem;
    border-top: 1px solid var(--border-light);
  }

  @media (min-width: 640px) {
    .article-meta-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .author-avatar {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background-color: var(--primary-light);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(37, 99, 235, 0.2);
  }

  .author-avatar svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .author-names {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .author-role {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .meta-details {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .meta-item.updated {
    color: var(--primary);
    font-weight: 500;
  }

  .meta-ico {
    width: 0.875rem;
    height: 0.875rem;
  }

  /* 2-Column Grid Layout */
  .article-layout-body {
    padding-top: 2.5rem;
  }

  .article-main-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .article-main-grid {
      grid-template-columns: minmax(0, 1fr) 280px;
    }
  }

  @media (min-width: 1200px) {
    .article-main-grid {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 3.5rem;
    }
  }

  .article-content-column {
    min-width: 0;
  }

  .article-sidebar-column {
    display: none;
  }

  @media (min-width: 1024px) {
    .article-sidebar-column {
      display: block;
    }
  }

  .sticky-sidebar-inner {
    position: sticky;
    top: 5.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sidebar-card {
    background-color: #FFFFFF;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    box-shadow: var(--shadow-xs);
  }

  .sidebar-card-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.75rem;
  }

  .copy-btn {
    width: 100%;
    gap: 0.4rem;
  }

  .copy-btn svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  .sidebar-tool-card {
    background: linear-gradient(135deg, #0B111A 0%, #151E2B 100%);
    border-color: #1F2937;
    color: #FFFFFF;
  }

  .sidebar-tool-card .sidebar-card-title {
    color: #FFFFFF;
    font-size: 0.9375rem;
  }

  .tool-card-icon {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .tool-card-desc {
    font-size: 0.78125rem;
    color: #94A3B8;
    line-height: 1.5;
    margin-bottom: 0.875rem;
  }

  /* Bottom Tags */
  .article-bottom-tags {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .tags-heading {
    font-size: 0.84375rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .tags-cluster {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-pill {
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    background-color: var(--bg-aux);
    border: 1px solid var(--border-light);
    color: var(--text-body);
    font-size: 0.8125rem;
    transition: all var(--transition-fast);
  }

  .tag-pill:hover {
    background-color: var(--primary-light);
    border-color: var(--primary);
    color: var(--primary);
  }

  /* Disclaimer Box */
  .article-disclaimer-box {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    background-color: var(--bg-aux);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .disclaimer-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 0.35rem;
  }

  .disclaimer-title svg {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--text-muted);
  }
</style>

<script>
  function initCopyLink() {
    const btn = document.getElementById('copy-link-btn');
    const textSpan = document.getElementById('copy-text');
    if (!btn || !textSpan) return;

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        textSpan.textContent = '已复制到剪贴板！';
        btn.classList.add('btn-primary');
        btn.classList.remove('btn-secondary');
        setTimeout(() => {
          textSpan.textContent = '复制文章链接';
          btn.classList.remove('btn-primary');
          btn.classList.add('btn-secondary');
        }, 2000);
      } catch (err) {
        textSpan.textContent = '复制失败';
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initCopyLink);
  document.addEventListener('astro:page-load', initCopyLink);
</script>
