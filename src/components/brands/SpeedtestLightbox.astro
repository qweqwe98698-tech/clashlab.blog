---
// SpeedtestLightbox.astro - ClashLab High-Definition Speedtest Modal with Zoom & Pan Controls
---

<div
  id="speedtest-lightbox"
  class="speedtest-lightbox-backdrop"
  role="dialog"
  aria-modal="true"
  aria-label="测速截图高清预览"
  hidden
>
  <div class="lightbox-container">
    <div class="lightbox-card">
      <!-- Dark Observatory Header (#0B111A) -->
      <header class="lightbox-header">
        <div class="lightbox-brand-info">
          <div class="lightbox-title-wrap">
            <span class="lightbox-live-indicator">
              <span class="live-dot"></span>
              <span>2026-08 实测归档</span>
            </span>
            <h3 id="lightbox-brand-name" class="lightbox-brand-title">机场测速报告</h3>
          </div>
          
          <div class="lightbox-meta-chips">
            <span class="meta-chip" id="lightbox-protocol-chip">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-icon"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
              <span id="lightbox-protocol">Shadowsocks</span>
            </span>
            <span class="meta-chip" id="lightbox-backend-chip">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-icon"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
              <span id="lightbox-backend">珠海联通 5Gbps / 32 线程</span>
            </span>
            <span class="meta-chip chip-highlight" id="lightbox-peak-chip">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-icon"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
              <span>峰值: </span><strong id="lightbox-peak">486.2 Mbps</strong>
            </span>
            <span class="meta-chip" id="lightbox-ping-chip">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-icon"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              <span>平均延迟: </span><span id="lightbox-ping">36.5ms</span>
            </span>
          </div>
        </div>

        <div class="lightbox-actions">
          <button type="button" id="lightbox-close-btn" class="lightbox-close-btn" aria-label="关闭预览 (ESC)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
            <span class="kbd-hint">ESC</span>
          </button>
        </div>
      </header>

      <!-- Main Image Viewport with Pan & Zoom -->
      <div class="lightbox-viewport-wrapper">
        <div class="lightbox-viewport" id="lightbox-viewport">
          <div class="lightbox-image-stage" id="lightbox-image-stage">
            <img
              id="lightbox-img"
              src=""
              alt="节点测速高清截图"
              class="lightbox-img"
              draggable="false"
            />
          </div>
        </div>

        <!-- Floating Zoom Toolbar -->
        <div class="lightbox-toolbar">
          <button type="button" class="toolbar-btn" id="zoom-in-btn" title="放大 (+)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </button>
          <span class="zoom-level-badge" id="zoom-level-badge">100%</span>
          <button type="button" class="toolbar-btn" id="zoom-out-btn" title="缩小 (-)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </button>
          <div class="toolbar-divider"></div>
          <button type="button" class="toolbar-btn" id="zoom-reset-btn" title="恢复原始大小 (1:1)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
              <path d="M3 3v5h5"></path>
            </svg>
          </button>
          <button type="button" class="toolbar-btn" id="fullscreen-toggle-btn" title="查看大图原图">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="15 3 21 3 21 9"></polyline>
              <polyline points="9 21 3 21 3 15"></polyline>
              <line x1="21" y1="3" x2="14" y2="10"></line>
              <line x1="3" y1="21" x2="10" y2="14"></line>
            </svg>
          </button>
        </div>
      </div>

      <!-- Technical Analysis & Transparency Disclaimer -->
      <footer class="lightbox-footer">
        <div class="analysis-box">
          <div class="analysis-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="analysis-icon">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <span class="analysis-title">实测分析与测试链路说明</span>
            <span class="analysis-time" id="lightbox-time">测试采样时间: 2026-08-11</span>
          </div>
          <p class="analysis-text" id="lightbox-analysis">
            节点在晚高峰实测中表现稳定，专线抖动处于优良水平。
          </p>
        </div>

        <div class="disclaimer-strip">
          <div class="disclaimer-text">
            <strong>⚠️ 实验室数据公开声明：</strong>以上截图基于 ClashLab 实验室当次压测环境，单线程/多线程速率受本地电信/联通/移动骨干网瞬时负载及客户端 TUN 配置影响，仅代表真实链路承载上限，不作绝对速率承诺。
          </div>
          <div class="lightbox-cta-links">
            <a id="lightbox-review-link" href="#" class="btn-lightbox-secondary">
              查看评测报告
            </a>
            <a id="lightbox-aff-link" href="#" target="_blank" rel="noopener noreferrer nofollow" class="btn-lightbox-primary">
              直达官网注册 →
            </a>
          </div>
        </div>
      </footer>
    </div>
  </div>
</div>

<style>
  /* Lightbox Backdrop */
  .speedtest-lightbox-backdrop {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background-color: rgba(11, 17, 26, 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s;
  }

  .speedtest-lightbox-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  @media (min-width: 768px) {
    .speedtest-lightbox-backdrop {
      padding: 2rem;
    }
  }

  /* Modal Container */
  .lightbox-container {
    width: 100%;
    max-width: 1060px;
    max-height: 94vh;
    display: flex;
    flex-direction: column;
    transform: translateY(16px) scale(0.97);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .speedtest-lightbox-backdrop.is-open .lightbox-container {
    transform: translateY(0) scale(1);
  }

  /* Card Frame */
  .lightbox-card {
    background-color: #0B111A;
    border: 1px solid #1F2937;
    border-radius: 12px;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(37, 99, 235, 0.25);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    max-height: 94vh;
  }

  /* Observatory Header */
  .lightbox-header {
    background: linear-gradient(180deg, #121A24 0%, #0B111A 100%);
    border-bottom: 1px solid #1F2937;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .lightbox-brand-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .lightbox-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lightbox-live-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.6875rem;
    font-weight: 700;
    color: #38BDF8;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10B981;
    box-shadow: 0 0 6px #10B981;
  }

  .lightbox-brand-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .lightbox-meta-chips {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .meta-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: #94A3B8;
    background-color: #151E2B;
    border: 1px solid #1F2937;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    font-family: ui-monospace, monospace;
  }

  .chip-icon {
    width: 13px;
    height: 13px;
    color: #38BDF8;
  }

  .meta-chip.chip-highlight {
    background: rgba(16, 185, 129, 0.1);
    border-color: rgba(16, 185, 129, 0.3);
    color: #34D399;
  }

  .meta-chip.chip-highlight strong {
    color: #10B981;
  }

  .lightbox-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lightbox-close-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    background-color: #151E2B;
    border: 1px solid #1F2937;
    border-radius: 6px;
    color: #CBD5E1;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .lightbox-close-btn svg {
    width: 16px;
    height: 16px;
  }

  .lightbox-close-btn:hover {
    background-color: #1F2937;
    color: #FFFFFF;
    border-color: #374151;
  }

  .kbd-hint {
    font-size: 0.6875rem;
    background: rgba(255, 255, 255, 0.1);
    padding: 0.05rem 0.3rem;
    border-radius: 3px;
    color: #94A3B8;
  }

  /* Viewport & Image Stage */
  .lightbox-viewport-wrapper {
    position: relative;
    background-color: #060A10;
    min-height: 280px;
    max-height: 52vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-viewport {
    width: 100%;
    height: 100%;
    max-height: 52vh;
    overflow: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    cursor: grab;
    user-select: none;
  }

  .lightbox-viewport.is-dragging {
    cursor: grabbing;
  }

  .lightbox-image-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s ease-out;
    transform-origin: center center;
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 48vh;
    object-fit: contain;
    border-radius: 6px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
    pointer-events: none;
  }

  /* Floating Toolbar */
  .lightbox-toolbar {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background-color: rgba(18, 26, 36, 0.9);
    border: 1px solid #1F2937;
    backdrop-filter: blur(8px);
    padding: 0.3rem 0.5rem;
    border-radius: var(--radius-full);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    z-index: 10;
  }

  .toolbar-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: #94A3B8;
    background: transparent;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .toolbar-btn svg {
    width: 16px;
    height: 16px;
  }

  .toolbar-btn:hover {
    color: #FFFFFF;
    background-color: rgba(255, 255, 255, 0.1);
  }

  .zoom-level-badge {
    font-size: 0.6875rem;
    font-family: ui-monospace, monospace;
    font-weight: 700;
    color: #38BDF8;
    padding: 0 0.35rem;
    min-width: 42px;
    text-align: center;
  }

  .toolbar-divider {
    width: 1px;
    height: 18px;
    background-color: #1F2937;
    margin: 0 0.2rem;
  }

  /* Footer & Transparency Rationale */
  .lightbox-footer {
    background-color: #0E1620;
    border-top: 1px solid #1F2937;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow-y: auto;
  }

  .analysis-box {
    background-color: #151E2B;
    border: 1px solid #1F2937;
    border-radius: 8px;
    padding: 0.875rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .analysis-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .analysis-icon {
    width: 15px;
    height: 15px;
    color: #38BDF8;
    flex-shrink: 0;
  }

  .analysis-title {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .analysis-time {
    font-size: 0.6875rem;
    color: #64748B;
    font-family: ui-monospace, monospace;
    margin-left: auto;
  }

  .analysis-text {
    font-size: 0.8125rem;
    color: #CBD5E1;
    line-height: 1.5;
    margin: 0;
  }

  .disclaimer-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .disclaimer-text {
    font-size: 0.75rem;
    color: #94A3B8;
    line-height: 1.5;
    max-width: 620px;
  }

  .disclaimer-text strong {
    color: #F59E0B;
  }

  .lightbox-cta-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .btn-lightbox-secondary {
    font-size: 0.75rem;
    font-weight: 600;
    color: #94A3B8;
    background-color: #151E2B;
    border: 1px solid #1F2937;
    padding: 0.45rem 0.85rem;
    border-radius: 6px;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-lightbox-secondary:hover {
    color: #FFFFFF;
    background-color: #1F2937;
  }

  .btn-lightbox-primary {
    font-size: 0.75rem;
    font-weight: 600;
    color: #FFFFFF;
    background: linear-gradient(135deg, #1D4ED8 0%, #2563EB 100%);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.45rem 1rem;
    border-radius: 6px;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
    transition: all var(--transition-fast);
  }

  .btn-lightbox-primary:hover {
    background: linear-gradient(135deg, #2563EB 0%, #38BDF8 100%);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.5);
  }
</style>

<script>
  class SpeedtestLightboxManager {
    backdrop: HTMLElement | null = null;
    brandTitle: HTMLElement | null = null;
    protocolElem: HTMLElement | null = null;
    backendElem: HTMLElement | null = null;
    peakElem: HTMLElement | null = null;
    pingElem: HTMLElement | null = null;
    timeElem: HTMLElement | null = null;
    analysisElem: HTMLElement | null = null;
    imgElem: HTMLImageElement | null = null;
    stageElem: HTMLElement | null = null;
    viewportElem: HTMLElement | null = null;
    reviewLink: HTMLAnchorElement | null = null;
    affLink: HTMLAnchorElement | null = null;
    closeBtn: HTMLElement | null = null;
    zoomLevelBadge: HTMLElement | null = null;

    zoomLevel: number = 1;
    isOpen: boolean = false;

    constructor() {
      this.initElements();
      this.bindEvents();
    }

    initElements() {
      this.backdrop = document.getElementById('speedtest-lightbox');
      this.brandTitle = document.getElementById('lightbox-brand-name');
      this.protocolElem = document.getElementById('lightbox-protocol');
      this.backendElem = document.getElementById('lightbox-backend');
      this.peakElem = document.getElementById('lightbox-peak');
      this.pingElem = document.getElementById('lightbox-ping');
      this.timeElem = document.getElementById('lightbox-time');
      this.analysisElem = document.getElementById('lightbox-analysis');
      this.imgElem = document.getElementById('lightbox-img') as HTMLImageElement;
      this.stageElem = document.getElementById('lightbox-image-stage');
      this.viewportElem = document.getElementById('lightbox-viewport');
      this.reviewLink = document.getElementById('lightbox-review-link') as HTMLAnchorElement;
      this.affLink = document.getElementById('lightbox-aff-link') as HTMLAnchorElement;
      this.closeBtn = document.getElementById('lightbox-close-btn');
      this.zoomLevelBadge = document.getElementById('zoom-level-badge');
    }

    bindEvents() {
      // Global delegated click listener for any speedtest trigger
      document.addEventListener('click', (e) => {
        const trigger = (e.target as HTMLElement).closest('[data-speedtest-img], .view-speedtest-btn, .link-speedtest') as HTMLElement;
        if (trigger) {
          e.preventDefault();
          this.openWithData(trigger);
        }
      });

      // Close handlers
      this.closeBtn?.addEventListener('click', () => this.close());
      this.backdrop?.addEventListener('click', (e) => {
        if (e.target === this.backdrop) {
          this.close();
        }
      });

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.isOpen) {
          e.preventDefault();
          this.close();
        }
      });

      // Zoom controls
      document.getElementById('zoom-in-btn')?.addEventListener('click', () => this.adjustZoom(0.25));
      document.getElementById('zoom-out-btn')?.addEventListener('click', () => this.adjustZoom(-0.25));
      document.getElementById('zoom-reset-btn')?.addEventListener('click', () => this.setZoom(1));
      document.getElementById('fullscreen-toggle-btn')?.addEventListener('click', () => {
        if (this.imgElem?.src) {
          window.open(this.imgElem.src, '_blank');
        }
      });

      // Mouse wheel zoom
      this.viewportElem?.addEventListener('wheel', (e) => {
        if (this.isOpen) {
          e.preventDefault();
          const delta = e.deltaY < 0 ? 0.15 : -0.15;
          this.adjustZoom(delta);
        }
      }, { passive: false });
    }

    openWithData(elem: HTMLElement) {
      const imgSrc = elem.getAttribute('data-speedtest-img') || '';
      const brandName = elem.getAttribute('data-brand-name') || '品牌测速实测';
      const protocol = elem.getAttribute('data-protocol') || 'Shadowsocks (AEAD)';
      const backend = elem.getAttribute('data-backend') || '珠海联通 5Gbps / 32 线程 / Ping 5次';
      const peakSpeed = elem.getAttribute('data-peak-speed') || '450.0 Mbps';
      const avgPing = elem.getAttribute('data-avg-ping') || '38.0ms';
      const testedAt = elem.getAttribute('data-tested-at') || '2026-08-11 晚高峰';
      const analysis = elem.getAttribute('data-analysis') || elem.getAttribute('data-notes') || '在 2026-08 晚高峰实测中，该品牌专线节点连通率保持 100%，网络抖动平稳。';
      const slug = elem.getAttribute('data-brand-slug') || '';
      const affUrl = elem.getAttribute('data-aff-url') || '';

      if (this.brandTitle) this.brandTitle.textContent = `${brandName} 晚高峰测速报告`;
      if (this.protocolElem) this.protocolElem.textContent = protocol;
      if (this.backendElem) this.backendElem.textContent = backend;
      if (this.peakElem) this.peakElem.textContent = peakSpeed;
      if (this.pingElem) this.pingElem.textContent = avgPing;
      if (this.timeElem) this.timeElem.textContent = `采样时间: ${testedAt}`;
      if (this.analysisElem) this.analysisElem.textContent = analysis;

      if (this.imgElem && imgSrc) {
        this.imgElem.src = imgSrc;
        this.imgElem.alt = `${brandName} 晚高峰测速实测图`;
      }

      if (this.reviewLink) {
        this.reviewLink.href = slug ? `/brands/${slug}` : '/brands';
      }

      if (this.affLink) {
        if (affUrl) {
          this.affLink.href = affUrl;
          this.affLink.style.display = 'inline-block';
        } else if (slug) {
          this.affLink.href = `/brands/${slug}`;
          this.affLink.style.display = 'inline-block';
        } else {
          this.affLink.style.display = 'none';
        }
      }

      this.setZoom(1);
      this.open();
    }

    open() {
      if (!this.backdrop) return;
      this.backdrop.hidden = false;
      requestAnimationFrame(() => {
        this.backdrop?.classList.add('is-open');
        this.isOpen = true;
        document.body.style.overflow = 'hidden';
      });
    }

    close() {
      if (!this.backdrop) return;
      this.backdrop.classList.remove('is-open');
      this.isOpen = false;
      document.body.style.overflow = '';
      setTimeout(() => {
        if (!this.isOpen && this.backdrop) {
          this.backdrop.hidden = true;
        }
      }, 250);
    }

    adjustZoom(delta: number) {
      this.setZoom(this.zoomLevel + delta);
    }

    setZoom(level: number) {
      this.zoomLevel = Math.max(0.5, Math.min(3.0, Math.round(level * 100) / 100));
      if (this.stageElem) {
        this.stageElem.style.transform = `scale(${this.zoomLevel})`;
      }
      if (this.zoomLevelBadge) {
        this.zoomLevelBadge.textContent = `${Math.round(this.zoomLevel * 100)}%`;
      }
    }
  }

  // Initialize on page load
  if (typeof window !== 'undefined') {
    new SpeedtestLightboxManager();
  }
</script>
