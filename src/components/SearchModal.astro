---
// SearchModal.astro - ClashLab Instant Client-Side Search Dialog
---

<div
  id="search-modal-backdrop"
  class="search-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-input"
  hidden
>
  <div class="search-modal-container">
    <div class="search-modal-card">
      <!-- Dark Tech Header (#0B111A) -->
      <header class="search-header">
        <div class="search-input-wrapper">
          <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          
          <input
            id="search-input"
            type="text"
            class="search-input"
            placeholder="搜索教程、协议、客户端配置、规则 (Ctrl+K)..."
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
          />

          <button id="search-clear-btn" class="search-clear-btn" aria-label="清空搜索" type="button" hidden>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>

          <div class="search-header-badges">
            <kbd class="kbd-badge" id="search-esc-btn" title="按 ESC 关闭">ESC</kbd>
          </div>
        </div>

        <!-- Filter Tags -->
        <div class="search-categories" id="search-categories">
          <button type="button" class="category-chip active" data-category="all">全部</button>
          <button type="button" class="category-chip" data-category="客户端教程">客户端教程</button>
          <button type="button" class="category-chip" data-category="协议知识">协议知识</button>
          <button type="button" class="category-chip" data-category="网络技术">网络技术</button>
          <button type="button" class="category-chip" data-category="机场观察">机场观察</button>
          <button type="button" class="category-chip" data-category="深度专题">深度专题</button>
        </div>
      </header>

      <!-- White Surface Results Body (#FFFFFF) -->
      <div class="search-body" id="search-body">
        <!-- Initial / Default State -->
        <div id="search-default-view" class="search-default-view">
          <div class="quick-section">
            <div class="quick-section-title">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
              <span>热门快速搜索</span>
            </div>
            <div class="quick-tags">
              <button type="button" class="quick-tag" data-query="Clash Verge Rev">Clash Verge Rev</button>
              <button type="button" class="quick-tag" data-query="Sing-box">Sing-box 规则集</button>
              <button type="button" class="quick-tag" data-query="Hysteria 2">Hysteria 2</button>
              <button type="button" class="quick-tag" data-query="IPLC">IPLC 专线</button>
              <button type="button" class="quick-tag" data-query="Fake-IP">Fake-IP 防泄漏</button>
              <button type="button" class="quick-tag" data-query="Shadowrocket">Shadowrocket 小火箭</button>
              <button type="button" class="quick-tag" data-query="TUN 模式">TUN 虚拟网卡</button>
              <button type="button" class="quick-tag" data-query="VLESS Reality">VLESS Reality</button>
            </div>
          </div>

          <div id="recent-searches-block" class="quick-section" hidden>
            <div class="quick-section-header">
              <div class="quick-section-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>最近搜索记录</span>
              </div>
              <button id="clear-recent-btn" type="button" class="clear-recent-btn">清除记录</button>
            </div>
            <div id="recent-searches-list" class="recent-list"></div>
          </div>
        </div>

        <!-- Live Search Results List -->
        <div id="search-results-view" class="search-results-view" hidden>
          <div class="results-stats">
            <span id="results-count">找到 0 篇相关技术文章</span>
            <span class="results-hint">使用 ↑ ↓ 键快速选择</span>
          </div>
          <ul id="search-results-list" class="results-list" role="listbox">
            <!-- Dynamic Items -->
          </ul>
        </div>

        <!-- Empty / No Results State -->
        <div id="search-empty-view" class="search-empty-view" hidden>
          <div class="empty-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </div>
          <p class="empty-title">未找到匹配的技术文档</p>
          <p class="empty-subtitle">尝试搜索更简短的关键词，如 <code>Clash</code>、<code>DNS</code>、<code>IPLC</code> 或 <code>TUN</code></p>
        </div>
      </div>

      <!-- Footer Keyboard Navigation Helper -->
      <footer class="search-footer">
        <div class="footer-shortcuts">
          <div class="shortcut-item">
            <kbd>↑</kbd><kbd>↓</kbd> <span>导航</span>
          </div>
          <div class="shortcut-item">
            <kbd>↵</kbd> <span>选择阅读</span>
          </div>
          <div class="shortcut-item">
            <kbd>ESC</kbd> <span>关闭</span>
          </div>
        </div>
        <div class="footer-brand">
          <span class="brand-dot"></span>
          <span>ClashLab Instant Search</span>
        </div>
      </footer>
    </div>
  </div>
</div>

<style>
  /* Search Modal Backdrop */
  .search-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 1.5rem 1rem;
    background-color: rgba(11, 17, 26, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.2s;
  }

  .search-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  @media (min-width: 640px) {
    .search-backdrop {
      padding: 4rem 1.5rem 2rem;
    }
  }

  /* Modal Card */
  .search-modal-container {
    width: 100%;
    max-width: 680px;
    transform: translateY(-12px) scale(0.98);
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .search-backdrop.is-open .search-modal-container {
    transform: translateY(0) scale(1);
  }

  .search-modal-card {
    display: flex;
    flex-direction: column;
    background-color: #FFFFFF;
    border-radius: 14px;
    border: 1px solid #1E293B;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(37, 99, 235, 0.15);
    overflow: hidden;
    max-height: 85vh;
  }

  /* Header: #0B111A Dark Tech */
  .search-header {
    background-color: #0B111A;
    border-bottom: 1px solid #1E293B;
    padding: 1.25rem 1.25rem 0.875rem;
    position: relative;
  }

  .search-header::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, #2563EB 30%, #0284C7 70%, transparent);
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background-color: #121A24;
    border: 1px solid #1F2937;
    border-radius: 8px;
    padding: 0.625rem 0.875rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .search-input-wrapper:focus-within {
    border-color: #2563EB;
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.25);
  }

  .search-icon {
    width: 20px;
    height: 20px;
    color: #38BDF8;
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #F9FAFB;
    font-size: 1rem;
    line-height: 1.5;
  }

  .search-input::placeholder {
    color: #64748B;
    font-size: 0.9375rem;
  }

  .search-clear-btn {
    color: #94A3B8;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: color 0.15s, background-color 0.15s;
  }

  .search-clear-btn:hover {
    color: #FFFFFF;
    background-color: #1E293B;
  }

  .search-header-badges {
    display: flex;
    align-items: center;
  }

  .kbd-badge {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6875rem;
    font-weight: 700;
    color: #94A3B8;
    background-color: #1A2332;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 0.15rem 0.45rem;
    cursor: pointer;
    transition: all 0.15s;
  }

  .kbd-badge:hover {
    color: #FFFFFF;
    border-color: #475569;
  }

  /* Category Filter Chips */
  .search-categories {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    overflow-x: auto;
    padding-top: 0.75rem;
    scrollbar-width: none;
  }

  .search-categories::-webkit-scrollbar {
    display: none;
  }

  .category-chip {
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #94A3B8;
    background-color: #151E2B;
    border: 1px solid #1F2937;
    border-radius: 6px;
    white-space: nowrap;
    cursor: pointer;
    transition: all 0.15s;
  }

  .category-chip:hover {
    color: #F8FAFC;
    background-color: #1E293B;
    border-color: #374151;
  }

  .category-chip.active {
    color: #FFFFFF;
    background-color: #2563EB;
    border-color: #3B82F6;
    box-shadow: 0 1px 3px rgba(37, 99, 235, 0.4);
  }

  /* Body Surface: #FFFFFF Light */
  .search-body {
    background-color: #FFFFFF;
    padding: 1rem 1.25rem;
    overflow-y: auto;
    flex: 1;
    min-height: 240px;
    max-height: 460px;
  }

  /* Quick Section (Default View) */
  .search-default-view {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 0.5rem 0;
  }

  .quick-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .quick-section-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #64748B;
    margin-bottom: 0.5rem;
  }

  .quick-section-title svg {
    color: #2563EB;
  }

  .clear-recent-btn {
    font-size: 0.75rem;
    color: #94A3B8;
    text-decoration: underline;
    cursor: pointer;
  }

  .clear-recent-btn:hover {
    color: #EF4444;
  }

  .quick-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .quick-tag {
    padding: 0.35rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #1E293B;
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .quick-tag:hover {
    background-color: #EFF6FF;
    color: #2563EB;
    border-color: #BFDBFE;
  }

  .recent-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .recent-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.75rem;
    background-color: #F8FAFC;
    border-radius: 6px;
    font-size: 0.875rem;
    color: #334155;
    cursor: pointer;
    transition: background-color 0.15s;
  }

  .recent-item:hover {
    background-color: #EFF6FF;
    color: #1D4ED8;
  }

  /* Results View */
  .results-stats {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    color: #64748B;
    padding: 0 0.25rem 0.625rem;
    border-bottom: 1px solid #F1F5F9;
    margin-bottom: 0.5rem;
  }

  .results-hint {
    display: none;
  }

  @media (min-width: 640px) {
    .results-hint {
      display: inline-block;
      color: #94A3B8;
    }
  }

  .results-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .result-item {
    border-radius: 8px;
    border: 1px solid #E2E8F0;
    background-color: #FFFFFF;
    transition: all 0.15s ease;
  }

  .result-link {
    display: block;
    padding: 0.75rem 1rem;
    color: inherit;
    text-decoration: none;
  }

  .result-item:hover,
  .result-item.active {
    background-color: #F8FAFC;
    border-color: #2563EB;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.08);
    transform: translateX(2px);
  }

  .result-item.active {
    outline: 2px solid #2563EB;
    outline-offset: -1px;
  }

  .result-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .result-badge {
    display: inline-block;
    padding: 0.15rem 0.45rem;
    font-size: 0.6875rem;
    font-weight: 700;
    color: #2563EB;
    background-color: #EFF6FF;
    border: 1px solid rgba(37, 99, 235, 0.2);
    border-radius: 4px;
    letter-spacing: 0.02em;
  }

  .result-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #0F172A;
    line-height: 1.4;
    margin-bottom: 0.25rem;
  }

  .result-item:hover .result-title,
  .result-item.active .result-title {
    color: #2563EB;
  }

  .result-desc {
    font-size: 0.8125rem;
    color: #475569;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .result-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.4rem;
  }

  .result-tag-item {
    font-size: 0.6875rem;
    color: #64748B;
    background-color: #F1F5F9;
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
  }

  /* Highlighting */
  :global(.search-highlight) {
    background-color: #FEF08A;
    color: #854D0E;
    font-weight: 700;
    padding: 0 0.15rem;
    border-radius: 2px;
  }

  /* Empty View */
  .search-empty-view {
    text-align: center;
    padding: 2.5rem 1rem;
  }

  .empty-icon-wrap {
    width: 54px;
    height: 54px;
    margin: 0 auto 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: #F1F5F9;
    color: #94A3B8;
  }

  .empty-title {
    font-size: 1rem;
    font-weight: 600;
    color: #1E293B;
    margin-bottom: 0.35rem;
  }

  .empty-subtitle {
    font-size: 0.8125rem;
    color: #64748B;
  }

  .empty-subtitle code {
    background-color: #F1F5F9;
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
    color: #2563EB;
  }

  /* Footer Keyboard Helper */
  .search-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: #F8FAFC;
    border-top: 1px solid #E2E8F0;
    padding: 0.625rem 1.25rem;
    font-size: 0.75rem;
    color: #64748B;
  }

  .footer-shortcuts {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .shortcut-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .shortcut-item kbd {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6875rem;
    font-weight: 700;
    color: #334155;
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 3px;
    padding: 0.1rem 0.35rem;
    box-shadow: 0 1px 1px rgba(0,0,0,0.05);
  }

  .footer-brand {
    display: none;
    align-items: center;
    gap: 0.35rem;
    font-weight: 500;
    color: #94A3B8;
  }

  @media (min-width: 640px) {
    .footer-brand {
      display: inline-flex;
    }
  }

  .brand-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10B981;
    box-shadow: 0 0 6px #10B981;
  }
</style>

<script>
  interface SearchItem {
    id: string;
    title: string;
    description: string;
    category: string;
    tags: string[];
    url: string;
    pubDate?: string;
    type?: string;
    image?: string;
  }

  class ClashLabSearch {
    backdrop: HTMLElement | null = null;
    input: HTMLInputElement | null = null;
    clearBtn: HTMLButtonElement | null = null;
    escBtn: HTMLElement | null = null;
    categoriesContainer: HTMLElement | null = null;
    defaultView: HTMLElement | null = null;
    resultsView: HTMLElement | null = null;
    emptyView: HTMLElement | null = null;
    resultsList: HTMLElement | null = null;
    resultsCount: HTMLElement | null = null;
    recentBlock: HTMLElement | null = null;
    recentList: HTMLElement | null = null;
    clearRecentBtn: HTMLButtonElement | null = null;

    searchIndex: SearchItem[] = [];
    currentResults: SearchItem[] = [];
    selectedIndex: number = -1;
    activeCategory: string = 'all';
    isOpen: boolean = false;
    hasFetched: boolean = false;

    constructor() {
      this.initElements();
      this.bindEvents();
      this.loadRecentSearches();
    }

    initElements() {
      this.backdrop = document.getElementById('search-modal-backdrop');
      this.input = document.getElementById('search-input') as HTMLInputElement;
      this.clearBtn = document.getElementById('search-clear-btn') as HTMLButtonElement;
      this.escBtn = document.getElementById('search-esc-btn');
      this.categoriesContainer = document.getElementById('search-categories');
      this.defaultView = document.getElementById('search-default-view');
      this.resultsView = document.getElementById('search-results-view');
      this.emptyView = document.getElementById('search-empty-view');
      this.resultsList = document.getElementById('search-results-list');
      this.resultsCount = document.getElementById('results-count');
      this.recentBlock = document.getElementById('recent-searches-block');
      this.recentList = document.getElementById('recent-searches-list');
      this.clearRecentBtn = document.getElementById('clear-recent-btn') as HTMLButtonElement;
    }

    bindEvents() {
      // Global shortcut listeners (Ctrl+K, Cmd+K, /, ESC)
      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
          e.preventDefault();
          this.toggleModal();
        } else if (e.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes((e.target as HTMLElement).tagName)) {
          e.preventDefault();
          this.openModal();
        } else if (e.key === 'Escape' && this.isOpen) {
          e.preventDefault();
          this.closeModal();
        }
      });

      // Triggers with [data-open-search] or [data-search-trigger]
      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement).closest('[data-open-search], [data-search-trigger], .btn-search-trigger');
        if (target) {
          e.preventDefault();
          this.openModal();
        }
      });

      // Backdrop click closes modal
      this.backdrop?.addEventListener('click', (e) => {
        if (e.target === this.backdrop) {
          this.closeModal();
        }
      });

      this.escBtn?.addEventListener('click', () => this.closeModal());

      // Input typing & clearing
      this.input?.addEventListener('input', () => {
        const query = this.input?.value.trim() || '';
        if (this.clearBtn) {
          this.clearBtn.hidden = query.length === 0;
        }
        this.performSearch(query);
      });

      this.clearBtn?.addEventListener('click', () => {
        if (this.input) {
          this.input.value = '';
          this.clearBtn!.hidden = true;
          this.input.focus();
          this.performSearch('');
        }
      });

      // Arrow navigation & Enter key on input
      this.input?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          this.navigateResults(1);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          this.navigateResults(-1);
        } else if (e.key === 'Enter') {
          e.preventDefault();
          this.selectActiveResult();
        }
      });

      // Category chip clicks
      this.categoriesContainer?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.category-chip') as HTMLElement;
        if (!btn) return;
        const category = btn.getAttribute('data-category') || 'all';
        this.setCategory(category);
      });

      // Quick Tag clicks
      this.defaultView?.addEventListener('click', (e) => {
        const tag = (e.target as HTMLElement).closest('.quick-tag') as HTMLElement;
        if (tag) {
          const query = tag.getAttribute('data-query') || '';
          if (this.input) {
            this.input.value = query;
            if (this.clearBtn) this.clearBtn.hidden = false;
            this.performSearch(query);
            this.input.focus();
          }
        }
      });

      // Clear recent searches
      this.clearRecentBtn?.addEventListener('click', () => {
        localStorage.removeItem('clashlab_recent_searches');
        this.loadRecentSearches();
      });
    }

    async fetchIndex() {
      if (this.hasFetched && this.searchIndex.length > 0) return;
      try {
        const res = await fetch('/api/search.json');
        if (res.ok) {
          this.searchIndex = await res.json();
          this.hasFetched = true;
        }
      } catch (err) {
        console.warn('ClashLab search index fallback to client defaults', err);
      }
    }

    openModal() {
      this.isOpen = true;
      if (this.backdrop) {
        this.backdrop.hidden = false;
        requestAnimationFrame(() => {
          this.backdrop?.classList.add('is-open');
        });
      }
      document.body.style.overflow = 'hidden';
      this.fetchIndex();
      setTimeout(() => {
        this.input?.focus();
        this.input?.select();
      }, 50);
    }

    closeModal() {
      this.isOpen = false;
      this.backdrop?.classList.remove('is-open');
      setTimeout(() => {
        if (!this.isOpen && this.backdrop) {
          this.backdrop.hidden = true;
        }
      }, 200);
      document.body.style.overflow = '';
    }

    toggleModal() {
      if (this.isOpen) {
        this.closeModal();
      } else {
        this.openModal();
      }
    }

    setCategory(category: string) {
      this.activeCategory = category;
      const chips = this.categoriesContainer?.querySelectorAll('.category-chip');
      chips?.forEach((chip) => {
        if (chip.getAttribute('data-category') === category) {
          chip.classList.add('active');
        } else {
          chip.classList.remove('active');
        }
      });
      this.performSearch(this.input?.value.trim() || '');
    }

    performSearch(query: string) {
      this.selectedIndex = -1;

      if (!query) {
        // Show default view
        if (this.defaultView) this.defaultView.hidden = false;
        if (this.resultsView) this.resultsView.hidden = true;
        if (this.emptyView) this.emptyView.hidden = true;
        this.currentResults = [];
        this.loadRecentSearches();
        return;
      }

      if (this.defaultView) this.defaultView.hidden = true;

      const tokens = query.toLowerCase().split(/\s+/).filter(Boolean);

      let matched = this.searchIndex.filter((item) => {
        // Category filter
        if (this.activeCategory !== 'all' && item.category !== this.activeCategory) {
          return false;
        }

        const title = (item.title || '').toLowerCase();
        const desc = (item.description || '').toLowerCase();
        const cat = (item.category || '').toLowerCase();
        const tags = (item.tags || []).map((t) => t.toLowerCase()).join(' ');

        // Must match all tokens
        return tokens.every(
          (t) => title.includes(t) || desc.includes(t) || cat.includes(t) || tags.includes(t)
        );
      });

      // Score and sort results
      matched.sort((a, b) => {
        const aTitle = a.title.toLowerCase();
        const bTitle = b.title.toLowerCase();
        const q = query.toLowerCase();

        const aTitleExact = aTitle === q ? 100 : aTitle.startsWith(q) ? 50 : aTitle.includes(q) ? 30 : 0;
        const bTitleExact = bTitle === q ? 100 : bTitle.startsWith(q) ? 50 : bTitle.includes(q) ? 30 : 0;

        return bTitleExact - aTitleExact;
      });

      this.currentResults = matched;

      if (matched.length === 0) {
        if (this.resultsView) this.resultsView.hidden = true;
        if (this.emptyView) this.emptyView.hidden = false;
      } else {
        if (this.emptyView) this.emptyView.hidden = true;
        if (this.resultsView) this.resultsView.hidden = false;
        if (this.resultsCount) {
          this.resultsCount.textContent = `找到 ${matched.length} 篇相关技术文档`;
        }
        this.renderResults(matched, tokens);
        // Pre-select first item
        this.selectedIndex = 0;
        this.updateActiveItem();
      }
    }

    renderResults(items: SearchItem[], tokens: string[]) {
      if (!this.resultsList) return;
      this.resultsList.innerHTML = items
        .map((item, index) => {
          const highlightedTitle = this.highlightText(item.title, tokens);
          const highlightedDesc = this.highlightText(item.description, tokens);
          const tagsHtml = (item.tags || [])
            .slice(0, 3)
            .map((t) => `<span class="result-tag-item">#${this.escapeHtml(t)}</span>`)
            .join('');

          return `
            <li class="result-item" data-index="${index}">
              <a href="${item.url}" class="result-link" data-url="${item.url}" data-title="${this.escapeHtml(item.title)}">
                <div class="result-top-row">
                  <span class="result-badge">${this.escapeHtml(item.category || '指南')}</span>
                  <span style="font-size:0.75rem; color:#94A3B8;">${item.type || '文章'}</span>
                </div>
                <div class="result-title">${highlightedTitle}</div>
                <div class="result-desc">${highlightedDesc}</div>
                ${tagsHtml ? `<div class="result-tags">${tagsHtml}</div>` : ''}
              </a>
            </li>
          `;
        })
        .join('');

      // Add click event for recent searches saving
      const links = this.resultsList.querySelectorAll('.result-link');
      links.forEach((link) => {
        link.addEventListener('click', (e) => {
          const title = link.getAttribute('data-title') || '';
          const url = link.getAttribute('data-url') || '';
          if (title && url) {
            this.saveRecentSearch(title, url);
          }
        });
      });
    }

    highlightText(text: string, tokens: string[]): string {
      if (!text || tokens.length === 0) return this.escapeHtml(text || '');
      let escaped = this.escapeHtml(text);
      tokens.forEach((token) => {
        if (!token) return;
        const escapedToken = token.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const regex = new RegExp(`(${escapedToken})`, 'gi');
        escaped = escaped.replace(regex, '<mark class="search-highlight">$1</mark>');
      });
      return escaped;
    }

    escapeHtml(str: string): string {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    navigateResults(direction: number) {
      if (this.currentResults.length === 0) return;
      this.selectedIndex += direction;
      if (this.selectedIndex < 0) {
        this.selectedIndex = this.currentResults.length - 1;
      } else if (this.selectedIndex >= this.currentResults.length) {
        this.selectedIndex = 0;
      }
      this.updateActiveItem();
    }

    updateActiveItem() {
      const items = this.resultsList?.querySelectorAll('.result-item');
      items?.forEach((item, index) => {
        if (index === this.selectedIndex) {
          item.classList.add('active');
          item.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        } else {
          item.classList.remove('active');
        }
      });
    }

    selectActiveResult() {
      if (this.selectedIndex >= 0 && this.selectedIndex < this.currentResults.length) {
        const item = this.currentResults[this.selectedIndex];
        this.saveRecentSearch(item.title, item.url);
        window.location.href = item.url;
      }
    }

    saveRecentSearch(title: string, url: string) {
      try {
        const raw = localStorage.getItem('clashlab_recent_searches');
        let list: { title: string; url: string }[] = raw ? JSON.parse(raw) : [];
        list = list.filter((r) => r.url !== url);
        list.unshift({ title, url });
        if (list.length > 5) list = list.slice(0, 5);
        localStorage.setItem('clashlab_recent_searches', JSON.stringify(list));
      } catch (e) {
        // ignore
      }
    }

    loadRecentSearches() {
      try {
        const raw = localStorage.getItem('clashlab_recent_searches');
        const list: { title: string; url: string }[] = raw ? JSON.parse(raw) : [];
        if (!this.recentBlock || !this.recentList) return;

        if (list.length > 0) {
          this.recentBlock.hidden = false;
          this.recentList.innerHTML = list
            .map(
              (r) => `
                <a href="${r.url}" class="recent-item">
                  <span>${this.escapeHtml(r.title)}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </a>
              `
            )
            .join('');
        } else {
          this.recentBlock.hidden = true;
          this.recentList.innerHTML = '';
        }
      } catch (e) {
        // ignore
      }
    }
  }

  // Initialize on DOM ready
  if (typeof window !== 'undefined') {
    const init = () => new ClashLabSearch();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  }
</script>
