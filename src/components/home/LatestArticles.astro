---
import Badge from '../common/Badge.astro';
import { getCollection } from 'astro:content';

let posts: any[] = [];
try {
  posts = await getCollection('posts');
  posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
} catch (e) {
  posts = [];
}

const defaultArticles = [
  {
    slug: 'clash-verge-rev-guide',
    data: {
      title: 'Clash Verge Rev 完整配置与内核切换实战手册 (2026 最新版)',
      description: '深入解析 Clash Verge Rev 的 Mihomo 内核集成、规则集分流体系、TUN 虚拟网卡模式以及晚高峰防丢包策略。',
      pubDate: new Date('2026-08-10'),
      category: '客户端教程',
      readTime: '12 分钟',
      author: 'ClashLab 实验室',
      tags: ['Clash', 'Mihomo', 'TUN模式', '规则分流']
    }
  },
  {
    slug: 'sing-box-mastery',
    data: {
      title: 'sing-box 现代路由与核心架构深度拆解：从配置结构到链式代理',
      description: '深入剖析 sing-box 1.10+ 的 JSON 规则路由、Inbound 嗅探与高性能内存占用调优，打造极速通用代理核心。',
      pubDate: new Date('2026-08-12'),
      category: '客户端教程',
      readTime: '9 分钟',
      author: 'ClashLab 实验室',
      tags: ['sing-box', '路由规则', '通用核心']
    }
  },
  {
    slug: 'airport-infrastructure-evaluation',
    data: {
      title: '2026 全球优质机场线路与网络基础设施深度横评：专线 vs BGP 中转',
      description: '多维度实测 IPLC/IEPL 跨境专线晚高峰抖动、流媒体原生解锁及多线容灾能力，附防跑路与避坑法则。',
      pubDate: new Date('2026-08-08'),
      category: '机场观察',
      readTime: '15 分钟',
      author: '网络基建小组',
      tags: ['IPLC专线', 'BGP中转', '晚高峰评测']
    }
  },
  {
    slug: 'shadowrocket-ios-tutorial',
    data: {
      title: 'Shadowrocket (小火箭) iOS 进阶配置与规则分流避坑指南',
      description: '覆盖 iOS 平台最流行的网络工具 Shadowrocket 订阅导入、证书解密、规则集自动化更新与常用分流配置。',
      pubDate: new Date('2026-08-06'),
      category: '客户端教程',
      readTime: '7 分钟',
      author: 'ClashLab 实验室',
      tags: ['Shadowrocket', 'iOS', '分流规则']
    }
  },
  {
    slug: 'dns-leak-protection-guide',
    data: {
      title: 'DNS 解析防泄漏与 Fake-IP / Redir-Host 机制深度剖析',
      description: '彻底搞懂客户端的 Fake-IP 工作原理、DoH 加密解析链路以及如何避免 WebRTC 真实 IP 暴露与 DNS 污染。',
      pubDate: new Date('2026-08-02'),
      category: '协议与原理',
      readTime: '11 分钟',
      author: '安全实验室',
      tags: ['DNS泄漏', 'Fake-IP', 'DoH', 'WebRTC']
    }
  },
  {
    slug: 'ip-types-and-risk-control',
    data: {
      title: '原生 IP vs 广播 IP：流媒体解锁与风控规避全景指南',
      description: '详解 Netflix/Disney+/ChatGPT/TikTok 对数据中心 IP 的封锁机制，以及住宅静态 IP 的真实应用场景。',
      pubDate: new Date('2026-07-28'),
      category: '避坑指南',
      readTime: '10 分钟',
      author: '安全实验室',
      tags: ['原生IP', '广播IP', '住宅IP', '流媒体解锁']
    }
  }
];

const displayArticles = posts.length > 0 ? posts.slice(0, 6) : defaultArticles;

const formatDate = (d: Date | string) => {
  const date = new Date(d);
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
};

const categories = ['全部', '客户端教程', '协议与原理', '机场观察', '避坑指南'];
---

<section class="latest-articles section">
  <div class="container">
    <!-- Header with category chips -->
    <div class="section-header">
      <div class="section-title-wrap">
        <span class="section-tag">LATEST INSIGHTS</span>
        <h2 class="section-title">最新技术文章与实战评测</h2>
        <p class="section-desc">保持最新视界，洞察代理技术演进与网络架构创新。</p>
      </div>

      <!-- Filter Categories -->
      <div class="category-tabs" role="tablist">
        {categories.map((cat, idx) => (
          <a
            href={cat === '全部' ? '/posts' : `/posts?category=${encodeURIComponent(cat)}`}
            class={`category-tab ${idx === 0 ? 'active' : ''}`}
          >
            {cat}
          </a>
        ))}
      </div>
    </div>

    <!-- Article Horizontal Cards List -->
    <div class="articles-list">
      {displayArticles.map((article: any, idx: number) => (
        <article class="card horizontal-article-card">
          <a href={`/posts/${article.slug || article.id}`} class="article-link">
            <!-- Left Visual / Tech Icon Badge -->
            <div class="article-visual-box">
              <div class="visual-inner">
                <span class="tech-num">0{idx + 1}</span>
                <span class="tech-tag-label">{article.data.category}</span>
              </div>
            </div>

            <!-- Right Content -->
            <div class="article-info">
              <div class="meta-row">
                <Badge variant={
                  article.data.category === '客户端教程' ? 'blue' :
                  article.data.category === '机场观察' ? 'green' :
                  article.data.category === '协议与原理' ? 'dark' : 'amber'
                } size="sm">
                  {article.data.category}
                </Badge>
                <span class="meta-dot"></span>
                <span class="meta-item">{formatDate(article.data.pubDate)}</span>
                <span class="meta-dot"></span>
                <span class="meta-item">{article.data.readTime || '8 分钟'}</span>
              </div>

              <h3 class="article-title card-title">
                {article.data.title}
              </h3>

              <p class="article-excerpt">
                {article.data.description}
              </p>

              <!-- Tags row -->
              {article.data.tags && article.data.tags.length > 0 && (
                <div class="article-tags-row">
                  {article.data.tags.slice(0, 3).map((tag: string) => (
                    <span class="tag-chip">#{tag}</span>
                  ))}
                </div>
              )}
            </div>

            <!-- Action Arrow -->
            <div class="article-arrow-wrap">
              <div class="arrow-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>

    <!-- View All CTA -->
    <div class="latest-footer-action">
      <a href="/posts" class="btn btn-secondary btn-lg">
        浏览全部历史文章 (知识库归档)
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .category-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 1rem;
  }

  @media (min-width: 640px) {
    .category-tabs {
      margin-top: 0;
    }
  }

  .category-tab {
    padding: 0.35rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    background-color: var(--bg-aux);
    border: 1px solid var(--border-light);
    transition: all var(--transition-fast);
  }

  .category-tab:hover {
    color: var(--text-main);
    background-color: #E5E7EB;
  }

  .category-tab.active {
    background-color: var(--primary);
    color: #FFFFFF;
    border-color: var(--primary);
  }

  /* Articles List */
  .articles-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .horizontal-article-card {
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .article-link {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    gap: 1.25rem;
    text-decoration: none;
    color: inherit;
  }

  @media (min-width: 640px) {
    .article-link {
      flex-direction: row;
      align-items: center;
      padding: 1.25rem 1.5rem;
    }
  }

  .article-visual-box {
    width: 100%;
    height: 100px;
    background: linear-gradient(135deg, #0B111A 0%, #172333 100%);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .article-visual-box {
      width: 140px;
      height: 110px;
    }
  }

  .visual-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    z-index: 2;
  }

  .tech-num {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 1.75rem;
    font-weight: 800;
    color: #38BDF8;
    line-height: 1;
  }

  .tech-tag-label {
    font-size: 0.6875rem;
    color: #94A3B8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .article-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .article-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.4;
    transition: color var(--transition-fast);
  }

  .article-excerpt {
    font-size: 0.875rem;
    color: var(--text-body);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.35rem;
  }

  .tag-chip {
    font-size: 0.75rem;
    color: var(--text-muted);
    background-color: var(--bg-aux);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .article-arrow-wrap {
    display: none;
  }

  @media (min-width: 768px) {
    .article-arrow-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      padding-left: 0.5rem;
    }
  }

  .arrow-circle {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background-color: var(--bg-aux);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: all var(--transition-fast);
  }

  .horizontal-article-card:hover .arrow-circle {
    background-color: var(--primary);
    color: #FFFFFF;
    transform: translateX(3px);
  }

  .arrow-circle svg {
    width: 1rem;
    height: 1rem;
  }

  .latest-footer-action {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }

  .arrow {
    width: 1rem;
    height: 1rem;
  }
</style>
