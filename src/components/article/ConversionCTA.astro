---
interface Props {
  type?: 'airport' | 'tools' | 'guide';
  title?: string;
  description?: string;
  primaryButtonText?: string;
  primaryButtonHref?: string;
  secondaryButtonText?: string;
  secondaryButtonHref?: string;
}

const {
  type = 'airport',
  title = '需要稳定低延迟的 2026 优质跨境网络支持？',
  description = 'ClashLab 实验室针对全球 30+ 主流机场进行多轮 20:00-23:00 晚高峰吞吐与抗丢包实测，严选真 IPLC 专线与多线 BGP 容灾节点。',
  primaryButtonText = '查阅 2026 优质机场横评榜单',
  primaryButtonHref = '/insights',
  secondaryButtonText = '订阅转换与测速工具',
  secondaryButtonHref = '/tools',
} = Astro.props;
---

<div class="conversion-cta-card">
  <div class="cta-inner">
    <!-- Header with Trust Badge -->
    <div class="cta-top-row">
      <span class="cta-tag">LAB RECOMMENDED</span>
      <div class="trust-pill">
        <span class="trust-dot"></span>
        <span>客观真实晚高峰实测</span>
      </div>
    </div>

    <!-- Title & Description -->
    <h3 class="cta-title">{title}</h3>
    <p class="cta-desc">{description}</p>

    <!-- Value propositions checklist -->
    <div class="cta-features">
      <div class="cta-feat-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="feat-icon">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>严选内网真专线，杜绝公网假冒伪劣</span>
      </div>
      <div class="cta-feat-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="feat-icon">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>支持 4K/8K 流媒体原生解锁与 ChatGPT 认证</span>
      </div>
      <div class="cta-feat-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="feat-icon">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>月付避坑法则与不跑路高信誉保障</span>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="cta-actions">
      <a href={primaryButtonHref} class="btn btn-primary btn-lg cta-primary-btn">
        <span>{primaryButtonText}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon-arrow">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      {secondaryButtonText && (
        <a href={secondaryButtonHref} class="btn btn-dark cta-secondary-btn">
          {secondaryButtonText}
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .conversion-cta-card {
    margin: 2.5rem 0;
    background: linear-gradient(135deg, #0B111A 0%, #15202E 100%);
    border: 1px solid #1F2937;
    border-radius: var(--radius-lg);
    box-shadow: 0 15px 30px -5px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(37, 99, 235, 0.15);
    color: #FFFFFF;
    position: relative;
    overflow: hidden;
  }

  .conversion-cta-card::before {
    content: "";
    position: absolute;
    top: -40px;
    right: -40px;
    width: 180px;
    height: 180px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-inner {
    padding: 1.75rem;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .cta-inner {
      padding: 2rem;
    }
  }

  .cta-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cta-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: #38BDF8;
    letter-spacing: 0.05em;
  }

  .trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    background-color: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
    font-size: 0.75rem;
    color: #34D399;
  }

  .trust-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10B981;
  }

  .cta-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  @media (min-width: 640px) {
    .cta-title {
      font-size: 1.5rem;
    }
  }

  .cta-desc {
    font-size: 0.9375rem;
    color: #94A3B8;
    line-height: 1.6;
  }

  .cta-features {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem 0;
  }

  .cta-feat-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #E2E8F0;
  }

  .feat-icon {
    width: 1rem;
    height: 1rem;
    color: #10B981;
    flex-shrink: 0;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .cta-primary-btn {
    background-color: var(--primary);
    border-color: var(--primary);
  }

  .cta-primary-btn:hover {
    background-color: var(--primary-hover);
    transform: translateY(-2px);
  }

  .btn-icon-arrow {
    width: 1rem;
    height: 1rem;
  }

  .cta-secondary-btn {
    border-color: #2D3748;
  }
</style>
