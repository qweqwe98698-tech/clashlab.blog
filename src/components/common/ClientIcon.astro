---
export interface Props {
  name: string;
  size?: number | string;
  class?: string;
  title?: string;
  color?: string;
}

const {
  name,
  size = 24,
  class: className = '',
  title,
  color,
} = Astro.props;

const normalizedName = (name || '').toLowerCase().trim().replace(/_/g, '-');

// Format size
const formattedSize = typeof size === 'number' ? `${size}px` : size;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={formattedSize}
  height={formattedSize}
  class:list={['clashlab-icon', `icon-${normalizedName}`, className]}
  aria-hidden={title ? undefined : "true"}
  role={title ? "img" : undefined}
  style={color ? `color: ${color};` : undefined}
>
  {title && <title>{title}</title>}
  {(() => {
    switch (normalizedName) {
      // 1. Clash / Clash Verge / Mihomo
      case 'clash':
      case 'clash-verge':
      case 'clash-meta':
      case 'mihomo':
        return (
          <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            {/* Outer Cat-shaped Cyber Shield */}
            <path d="M4 10.5V17a4 4 0 0 0 4 4h8a4 4 0 0 0 4-4v-6.5L18 4l-4.5 3.5h-3L6 4L4 10.5Z" fill="currentColor" fill-opacity="0.12" />
            {/* Whiskers / Nodes */}
            <path d="M9 13.5h.01M15 13.5h.01" stroke-width="2.5" />
            <path d="M10 16.5c.6.5 1.3.8 2 .8s1.4-.3 2-.8" />
            <path d="M2 13h3M22 13h-3" />
            <path d="M12 4v2" />
          </g>
        );

      // 2. Shadowrocket
      case 'shadowrocket':
      case 'rocket':
        return (
          <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4.5 16.5c-1.5 1.26-2 4-2 4s2.74-.5 4-2c.35-.42.66-.88.94-1.37L4.5 16.5Z" fill="currentColor" fill-opacity="0.15" />
            <path d="M12 15l-3-3m5.5-5.5a13.5 13.5 0 0 1 5-4.5c.5-.3 1 0 1 .5a13.5 13.5 0 0 1-4.5 5L15 13l-4 1-2-2 1-4 4.5-1Z" />
            <path d="M9 20l3-3" />
            <path d="M15 5l4 4" />
            <circle cx="15.5" cy="8.5" r="1.5" fill="currentColor" />
            {/* Thrust Flame */}
            <path d="M5.5 18.5L3 21" stroke-width="2" />
          </g>
        );

      // 3. Sing-box
      case 'sing-box':
      case 'singbox':
        return (
          <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            {/* Isometric Cyber Cube */}
            <path d="M12 2.5L20.5 7.5v9L12 21.5L3.5 16.5v-9L12 2.5Z" fill="currentColor" fill-opacity="0.1" />
            <path d="M12 2.5v19" stroke-dasharray="1 3" stroke-opacity="0.5" />
            <path d="M20.5 7.5L12 12L3.5 7.5" />
            <path d="M12 12v9.5" />
            {/* Stylized 'S' Wave inside Cube */}
            <path d="M15.5 6.5C14.5 5.8 13.3 6 12 6.8c-1.5.9-1.8 2.2-.5 3 1.3.8 2.8 1.4 2.8 2.7 0 1.5-1.5 2.2-3.3 2" stroke-width="2" />
          </g>
        );

      // 4. v2rayN / V2Ray / Xray
      case 'v2rayn':
      case 'v2ray':
      case 'xray':
        return (
          <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            {/* Modern V Shield Monogram */}
            <path d="M3 4.5L12 21.5L21 4.5" />
            <path d="M7 4.5L12 14.5L17 4.5" fill="currentColor" fill-opacity="0.15" />
            <path d="M2 4.5h3.5M18.5 4.5H22" />
            <circle cx="12" cy="14.5" r="1.5" fill="currentColor" />
            <path d="M12 2v2.5" />
          </g>
        );

      // 5. Hiddify / Hiddify-Next
      case 'hiddify':
      case 'hiddify-next':
        return (
          <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            {/* Cyber Shield with H Glyph */}
            <path d="M12 2.5L4 6v6.5C4 17.5 7.5 21 12 22.5c4.5-1.5 8-5 8-10V6L12 2.5Z" fill="currentColor" fill-opacity="0.12" />
            {/* H Monogram */}
            <path d="M8.5 8.5v7" stroke-width="2" />
            <path d="M15.5 8.5v7" stroke-width="2" />
            <path d="M8.5 12h7" stroke-width="2" />
            <circle cx="12" cy="12" r="1.2" fill="currentColor" />
          </g>
        );

      // 6. Windows
      case 'windows':
      case 'win':
        return (
          <g fill="currentColor">
            <path d="M3 5.46L10.36 4.45V11.23H3V5.46Z" />
            <path d="M11.64 4.28L21 3V11.23H11.64V4.28Z" />
            <path d="M3 12.77H10.36V19.55L3 18.54V12.77Z" />
            <path d="M11.64 12.77H21V21L11.64 19.72V12.77Z" />
          </g>
        );

      // 7. Apple / iOS / macOS
      case 'apple':
      case 'ios':
      case 'macos':
      case 'mac':
        return (
          <g fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.61-.75 1.04-1.8 0.92-2.87-.92.04-2.02.62-2.66 1.37-.57.65-1.06 1.73-.93 2.76 1.02.08 2.06-.51 2.67-1.26Z" />
          </g>
        );

      // 8. Android
      case 'android':
        return (
          <g fill="currentColor">
            {/* Head Dome */}
            <path d="M6 14a6 6 0 0 1 12 0H6Z" />
            {/* Eyes */}
            <circle cx="8.5" cy="11" r="0.9" fill="#0B111A" />
            <circle cx="15.5" cy="11" r="0.9" fill="#0B111A" />
            {/* Antennas */}
            <line x1="7.2" y1="7.2" x2="5.5" y2="4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            <line x1="16.8" y1="7.2" x2="18.5" y2="4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            {/* Lower Body Pill */}
            <rect x="6" y="15.5" width="12" height="3" rx="1.5" />
          </g>
        );

      // 9. Linux
      case 'linux':
      case 'ubuntu':
      case 'debian':
        return (
          <g fill="currentColor">
            {/* Tux Modern Silhouette */}
            <path d="M12 2C9.5 2 8 3.8 8 6.5c0 1.2.3 2.5.5 3.5C7.2 11.2 6 13.5 6 16.5c0 2.8 1.8 4.5 4.5 4.5.8 0 1.8-.2 2.5-.2.7 0 1.7.2 2.5.2 2.7 0 4.5-1.7 4.5-4.5 0-3-1.2-5.3-2.5-6.5.2-1 .5-2.3.5-3.5C18 3.8 16.5 2 12 2Z" fill-opacity="0.85" />
            {/* White Belly */}
            <ellipse cx="12" cy="15.5" rx="3.5" ry="4.2" fill="#FFFFFF" fill-opacity="0.9" />
            {/* Eyes */}
            <circle cx="10.5" cy="6" r="0.8" fill="#0B111A" />
            <circle cx="13.5" cy="6" r="0.8" fill="#0B111A" />
            {/* Beak */}
            <path d="M11 7.8h2l-1 1.4z" fill="#F59E0B" />
            {/* Feet */}
            <ellipse cx="8.5" cy="21" rx="2" ry="1" fill="#F59E0B" />
            <ellipse cx="15.5" cy="21" rx="2" ry="1" fill="#F59E0B" />
          </g>
        );

      // Fallback: Terminal / Shield Icon
      default:
        return (
          <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="16" rx="3" />
            <path d="M7 9l4 3l-4 3" />
            <path d="M13 15h4" />
          </g>
        );
    }
  })()}
</svg>

<style>
  .clashlab-icon {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
</style>
