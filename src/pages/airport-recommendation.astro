<script>
  // Quick coupon copy button helper for pillar page
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-coupon]') as HTMLElement;
    if (!btn) return;
    const code = btn.getAttribute('data-coupon') || '';
    if (code) {
      navigator.clipboard.writeText(code).then(() => {
        const hint = btn.querySelector('.copy-hint-text') || btn.querySelector('.copy-hint');
        if (hint) {
          const prev = hint.textContent;
          hint.textContent = '已复制!';
          setTimeout(() => {
            hint.textContent = prev;
          }, 1800);
        }
      }).catch(() => {});
    }
  });
</script>
