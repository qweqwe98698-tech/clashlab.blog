---
// src/pages/brands/index.astro - ClashLab Network Observatory Brand Directory & Speedtest Matrix
import PageLayout from '../../layouts/PageLayout.astro';
import Badge from '../../components/common/Badge.astro';
import ConversionCTA from '../../components/article/ConversionCTA.astro';
import SpeedtestLightbox from '../../components/brands/SpeedtestLightbox.astro';
import DataDisclosureModal from '../../components/brands/DataDisclosureModal.astro';
import { brands } from '../../data/brands';

const pageTitle = '2026 机场品牌库与晚高峰节点测速大盘 - 16家专线品牌实测矩阵';
const pageDescription = 'ClashLab 实验室 2026 主流机场品牌数据库：全量收录 16 家 IEPL 专线与综合型机场，提供 2026-08 晚高峰真实节点测速原图、多维度动态条件筛选、四层数据披露白皮书与专属优惠码。';

// Stats calculation
const totalBrands = brands.length;
const ieplCoverage = '100%';
const packetLossRate = '0%';
const latestTestBatch = '2026-08 节点压测';
---

<PageLayout
  title={pageTitle}
  description={pageDescription}
  tagline="NETWORK OBSERVATORY & SPEEDTEST MATRIX"
  breadcrumbCurrent="机场品牌库"
>
  <div class="brands-index-page">
    <!-- Top Observatory Infrastructure Snapshot Metrics Banner -->
    <section class="observatory-banner">
      <div class="banner-glass-glow"></div>
      <div class="banner-top-telemetry">
        <div class="telemetry-live-pill">
          <span class="pulse-beacon"></span>
          <span class="telemetry-title">ClashLab 实验室节点探针在线监控中</span>
        </div>
        <button type="button" class="btn-disclosure-trigger" data-open-disclosure>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="info-icon">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          <span>四层实测审计白皮书</span>
        </button>
      </div>

      <div class="banner-content">
        <h2 class="banner-headline">
          2026 机场品牌库与真实测速大盘
        </h2>
        <p class="banner-subtext">
          拒绝虚标与口水营销。ClashLab 坚持客观透明原则，所有测试数据均来自 2026-08 黄金晚高峰（20:00–23:00）5Gbps / 9G 专线集群实机压测，完整保留单线程峰值吞吐、骨干线路拓扑与高清测速截图。
        </p>
      </div>

      <!-- High-density Infrastructure Snapshot Metrics Grid -->
      <div class="snapshot-metrics-grid">
        <div class="metric-block">
          <div class="metric-k">收录品牌</div>
          <div class="metric-v">
            <span class="v-num">{totalBrands}</span>
            <span class="v-unit">家品牌已归档</span>
          </div>
          <span class="metric-sub">全量覆盖亚太/欧美核心专线</span>
        </div>

        <div class="metric-block">
          <div class="metric-k">专线架构</div>
          <div class="metric-v">
            <span class="v-num highlight-sky">{ieplCoverage}</span>
            <span class="v-unit">专线覆盖</span>
          </div>
          <span class="metric-sub">物理内网 IEPL / BGP 端到端</span>
        </div>

        <div class="metric-block">
          <div class="metric-k">压测 SLA</div>
          <div class="metric-v">
            <span class="v-num highlight-green">{packetLossRate}</span>
            <span class="v-unit">晚高峰丢包基准</span>
          </div>
          <span class="metric-sub">32 线程并发满载抗抖动测试</span>
        </div>

        <div class="metric-block">
          <div class="metric-k">最新采样批次</div>
          <div class="metric-v">
            <span class="v-num highlight-amber">2026-08</span>
            <span class="v-unit">实测归档</span>
          </div>
          <span class="metric-sub">珠海联通 5G / 9G 集群探针</span>
        </div>
      </div>
    </section>

    <!-- Four-Layer Data Disclosure Interactive Callout Strip -->
    <section class="disclosure-callout-section">
      <div class="disclosure-card-inline">
        <div class="dci-header">
          <div class="dci-title-wrap">
            <span class="dci-tag">METHODOLOGY TRANSPARENCY</span>
            <h3 class="dci-title">ClashLab 四层数据披露与实测审计体系</h3>
          </div>
          <button type="button" class="btn btn-secondary btn-sm" data-open-disclosure>
            查看白皮书细则 →
          </button>
        </div>

        <div class="dci-layers-grid">
          <div class="dci-layer-item">
            <span class="dci-layer-badge">Layer 1</span>
            <strong class="dci-layer-name">物理链路审计</strong>
            <p class="dci-layer-p">端到端运营商内网 IEPL 专线直连，杜绝公网伪装，Jitter &lt; 2ms</p>
          </div>
          <div class="dci-layer-item">
            <span class="dci-layer-badge">Layer 2</span>
            <strong class="dci-layer-name">晚高峰满载压测</strong>
            <p class="dci-layer-p">20:00–23:00 黄金晚高峰 5Gbps / 9G 专线集群 32 线程丢包率与抖动抓取</p>
          </div>
          <div class="dci-layer-item">
            <span class="dci-layer-badge">Layer 3</span>
            <strong class="dci-layer-name">原生风控与解锁</strong>
            <p class="dci-layer-p">原生住宅/机房纯净 IP 池，针对 ChatGPT、Claude、Netflix 4K 解锁校验</p>
          </div>
          <div class="dci-layer-item">
            <span class="dci-layer-badge">Layer 4</span>
            <strong class="dci-layer-name">协议与客户端生态</strong>
            <p class="dci-layer-p">全线适配 VLESS / Shadowsocks，支持 Clash Verge Rev、sing-box 一键导入</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Multi-Dimensional Live Filter Control Center -->
    <section class="filter-center-section" id="filter-center">
      <div class="filter-panel-card">
        <!-- Search & Quick Action Topbar -->
        <div class="filter-topbar">
          <div class="search-input-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="brand-search-input"
              class="brand-search-input"
              placeholder="搜索品牌名称、拼音、协议 (VLESS)、特性 (如 ChatGPT、4K、不限时)..."
              autocomplete="off"
              spellcheck="false"
            />
            <button type="button" id="clear-search-btn" class="clear-search-btn" aria-label="清空搜索" hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>

          <div class="filter-actions">
            <button type="button" id="reset-filters-btn" class="btn-reset-filters">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="reset-icon">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                <path d="M3 3v5h5"></path>
              </svg>
              <span>重置所有筛选</span>
            </button>
          </div>
        </div>

        <!-- Filter Dimensions Rows -->
        <div class="filter-dimensions-wrap">
          <!-- Dimension 1: Price Tier -->
          <div class="filter-dimension-row">
            <span class="dim-label">起步月付：</span>
            <div class="dim-buttons" data-filter-group="price">
              <button type="button" class="filter-chip active" data-value="all">全部价格</button>
              <button type="button" class="filter-chip" data-value="p-budget">≤ ¥10 /月 (极致平价)</button>
              <button type="button" class="filter-chip" data-value="p-standard">¥11 – ¥20 /月 (主流实用)</button>
              <button type="button" class="filter-chip" data-value="p-premium">≥ ¥21 /月 (旗舰大流量)</button>
            </div>
          </div>

          <!-- Dimension 2: Protocol -->
          <div class="filter-dimension-row">
            <span class="dim-label">协议架构：</span>
            <div class="dim-buttons" data-filter-group="protocol">
              <button type="button" class="filter-chip active" data-value="all">全部协议</button>
              <button type="button" class="filter-chip" data-value="vless">VLESS 现代协议</button>
              <button type="button" class="filter-chip" data-value="shadowsocks">Shadowsocks (AEAD)</button>
            </div>
          </div>

          <!-- Dimension 3: Tier Ranking -->
          <div class="filter-dimension-row">
            <span class="dim-label">梯队评级：</span>
            <div class="dim-buttons" data-filter-group="tier">
              <button type="button" class="filter-chip active" data-value="all">全部梯队</button>
              <button type="button" class="filter-chip" data-value="T1">T1 综合首选与旗舰专线</button>
              <button type="button" class="filter-chip" data-value="T2">T2 性价比主力专线</button>
              <button type="button" class="filter-chip" data-value="T3">T3 便宜备用与不限时</button>
            </div>
          </div>

          <!-- Dimension 4: Feature Tags -->
          <div class="filter-dimension-row">
            <span class="dim-label">场景特性：</span>
            <div class="dim-buttons" data-filter-group="feature">
              <button type="button" class="filter-chip active" data-value="all">全部特性</button>
              <button type="button" class="filter-chip" data-value="ai">AI / ChatGPT 优化</button>
              <button type="button" class="filter-chip" data-value="streaming">4K / 8K 流媒体解锁</button>
              <button type="button" class="filter-chip" data-value="traffic">150GB+ 大流量</button>
              <button type="button" class="filter-chip" data-value="noexpiry">不限时 / 永久按量</button>
              <button type="button" class="filter-chip" data-value="old">3年以上老牌稳定</button>
            </div>
          </div>
        </div>

        <!-- Filter Status Bar -->
        <div class="filter-status-bar">
          <div class="match-count-wrap">
            <span>实时匹配：</span>
            <span class="count-badge">
              <strong id="matched-count">{totalBrands}</strong> / {totalBrands} 家品牌
            </span>
          </div>
          <div class="active-filter-chips" id="active-filter-chips">
            <!-- Dynamic active filter pills -->
          </div>
        </div>
      </div>
    </section>

    <!-- Brands Grid Section -->
    <section class="brands-section" id="brands-grid-section">
      <div class="section-header">
        <div class="section-title-wrap">
          <span class="section-tag">DIRECTORY &amp; TELEMETRY</span>
          <h2 class="section-title">收录品牌全景评测矩阵</h2>
          <p class="section-desc">支持单击测速缩略图查看高清原图，或进入评测报告查阅完整链路分析</p>
        </div>
      </div>

      <!-- No Match Empty View -->
      <div id="no-results-view" class="no-results-view" hidden>
        <div class="no-results-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </div>
        <h3>未找到符合当前组合条件的机场品牌</h3>
        <p>建议放宽价格或特性筛选，或点击下方按钮重置所有筛选条件。</p>
        <button type="button" class="btn btn-primary btn-sm" id="empty-reset-btn">
          重置所有筛选条件
        </button>
      </div>

      <!-- Brands Cards Grid -->
      <div class="grid-4 brands-grid" id="brands-grid-container">
        {brands.map((brand) => (
          <article
            class="card brand-card"
            data-brand-card
            data-brand-id={brand.id}
            data-slug={brand.slug}
            data-name={brand.name}
            data-english-name={brand.englishName}
            data-pinyin={brand.pinyin}
            data-price={brand.entryPriceNum}
            data-tier={brand.tier}
            data-protocols={brand.techArchitecture.protocols.join(',')}
            data-tags={brand.tags.join(',')}
            data-desc={brand.description}
            data-tagline={brand.tagline}
            data-established={brand.establishedYear}
            data-traffic={parseInt(brand.plans[0]?.traffic || '100')}
            data-has-no-expiry={brand.slug === 'xingdaomeng' ? 'true' : 'false'}
          >
            <!-- Top Row: Name, Badge, Tier & Rating -->
            <div class="bc-top-row">
              <div class="bc-name-wrap">
                <div class="bc-title-line">
                  <h3 class="bc-name">
                    <a href={`/brands/${brand.slug}`} class="brand-title-link">
                      {brand.name}
                    </a>
                  </h3>
                  {brand.badge && <span class="bc-badge">{brand.badge}</span>}
                </div>
                <span class="bc-subname">{brand.englishName} · {brand.establishedYear}年创立</span>
              </div>
              <div class="bc-tier-rating">
                <span class={`tier-pill tier-${brand.tier.toLowerCase()}`}>{brand.tier}</span>
                <div class="bc-rating-pill" title={`评分 ${brand.rating} / 5.0`}>
                  <span class="star">★</span>
                  <span>{brand.rating}</span>
                </div>
              </div>
            </div>

            <!-- Tagline -->
            <p class="bc-tagline">{brand.tagline}</p>

            <!-- Speedtest Snapshot Thumbnail with Lightbox Trigger -->
            <div
              class="bc-thumb-wrap view-speedtest-btn"
              data-speedtest-img={brand.speedtest.image}
              data-brand-name={brand.name}
              data-brand-slug={brand.slug}
              data-protocol={brand.speedtest.protocol}
              data-backend={brand.speedtest.backend}
              data-peak-speed={brand.speedtest.peakSpeed}
              data-avg-ping={brand.speedtest.avgPing}
              data-tested-at={brand.speedtest.testedAt}
              data-analysis={brand.speedtest.analysis}
              data-aff-url={brand.commercial.affiliateUrl}
              role="button"
              tabindex="0"
              title="点击查看 2026-08 高清测速大图"
            >
              <img
                src={brand.speedtest.image}
                alt={`${brand.name} 2026 测速截图缩略图`}
                class="bc-thumb-img"
                width="400"
                height="225"
                loading="lazy"
              />
              <div class="bc-thumb-overlay">
                <span class="thumb-tag">实测峰值: {brand.speedtest.peakSpeed}</span>
                <span class="thumb-zoom-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                  </svg>
                  <span>放大原图</span>
                </span>
              </div>
            </div>

            <!-- Key Specs Strip -->
            <div class="bc-specs-row">
              <div class="bc-spec-col">
                <span class="spec-k">起步资费</span>
                <span class="spec-v price">{brand.entryPrice}</span>
              </div>
              <div class="bc-spec-col">
                <span class="spec-k">月付流量</span>
                <span class="spec-v">{brand.plans[0]?.traffic || '100 GB'}</span>
              </div>
              <div class="bc-spec-col">
                <span class="spec-k">实测协议</span>
                <span class="spec-v">{brand.speedtest.protocol.split(' ')[0]}</span>
              </div>
              <div class="bc-spec-col">
                <span class="spec-k">骨干链路</span>
                <span class="spec-v">IEPL 专线</span>
              </div>
            </div>

            <!-- Coupon Tag with Copy Button -->
            <div class="bc-coupon-strip">
              <div class="coupon-left">
                <span class="coupon-lbl">优惠码:</span>
                <code class="coupon-txt">{brand.couponCode}</code>
              </div>
              <button
                type="button"
                class="copy-btn-mini"
                data-coupon={brand.couponCode}
                title="点击复制优惠码"
              >
                <span class="copy-label">复制</span>
              </button>
            </div>

            <!-- Action Footer -->
            <div class="bc-footer">
              <a href={`/brands/${brand.slug}`} class="view-review-btn">
                <span>评测详情</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </a>
              <a
                href={brand.commercial.affiliateUrl}
                target="_blank"
                rel="nofollow sponsored noopener"
                class="btn-visit-brand-sm"
              >
                <span>官网注册</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Comprehensive Comparison Table Matrix -->
    <section class="matrix-section" id="matrix-table-section">
      <div class="section-header">
        <div class="section-title-wrap">
          <span class="section-tag">COMPREHENSIVE MATRIX</span>
          <h2 class="section-title">16 家机场核心参数横向速查表</h2>
          <p class="section-desc">汇聚 16 家品牌的基础资费、协议支持、实测峰值、专属优惠码与直达注册链接</p>
        </div>
      </div>

      <div class="table-wrapper">
        <table class="matrix-table" id="matrix-table">
          <thead>
            <tr>
              <th>品牌名称</th>
              <th>梯队</th>
              <th>起步月付</th>
              <th>月流量</th>
              <th>骨干专线</th>
              <th>实测协议</th>
              <th>实测单线最高速率</th>
              <th>平均延迟</th>
              <th>专属优惠码</th>
              <th>测速原图</th>
              <th>官网注册</th>
            </tr>
          </thead>
          <tbody>
            {brands.map((b) => (
              <tr data-table-row data-slug={b.slug} data-tier={b.tier} data-price={b.entryPriceNum}>
                <td>
                  <a href={`/brands/${b.slug}`} class="table-brand-link">
                    <strong>{b.name}</strong>
                    <span class="table-sub">{b.englishName}</span>
                  </a>
                </td>
                <td>
                  <span class={`tier-indicator tier-${b.tier.toLowerCase()}`}>{b.tier}</span>
                </td>
                <td><code class="table-price">{b.entryPrice}</code></td>
                <td><strong>{parseInt(b.plans[0]?.traffic || '100')}</strong> GB</td>
                <td><span class="line-tag">IEPL 专线</span></td>
                <td><span class="badge badge-blue">{b.speedtest.protocol.split(' ')[0]}</span></td>
                <td style="color: #10B981; font-weight: 700;">{b.speedtest.peakSpeed}</td>
                <td><span class="ping-text">{b.speedtest.avgPing}</span></td>
                <td>
                  <button
                    type="button"
                    class="table-coupon-btn"
                    data-coupon={b.couponCode}
                    title="点击复制优惠码"
                  >
                    <code>{b.couponCode}</code>
                  </button>
                </td>
                <td>
                  <button
                    type="button"
                    class="btn-table-speedtest view-speedtest-btn"
                    data-speedtest-img={b.speedtest.image}
                    data-brand-name={b.name}
                    data-brand-slug={b.slug}
                    data-protocol={b.speedtest.protocol}
                    data-backend={b.speedtest.backend}
                    data-peak-speed={b.speedtest.peakSpeed}
                    data-avg-ping={b.speedtest.avgPing}
                    data-tested-at={b.speedtest.testedAt}
                    data-analysis={b.speedtest.analysis}
                    data-aff-url={b.commercial.affiliateUrl}
                  >
                    查看原图
                  </button>
                </td>
                <td>
                  <a
                    href={b.commercial.affiliateUrl}
                    target="_blank"
                    rel="nofollow sponsored noopener"
                    class="btn btn-primary btn-sm table-reg-btn"
                  >
                    注册直达
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Bottom Conversion CTA -->
    <ConversionCTA
      title="如何挑选适合您的 2026 跨境专线方案？"
      description="坚持「月付上车」黄金避坑法则，查看 2026 机场推荐与稳定天梯总榜，按 4K 追剧、AI 对话或多设备大流量精准匹配。"
      primaryButtonText="查阅 2026 机场推荐天梯榜"
      primaryButtonHref="/airport-recommendation"
      secondaryButtonText="2026 机场选购避坑指南"
      secondaryButtonHref="/posts/2026-airport-selection-benchmark-guide"
    />
  </div>

  <!-- Speedtest Lightbox Modal -->
  <SpeedtestLightbox />

  <!-- Four-Layer Data Disclosure Modal -->
  <DataDisclosureModal />
</PageLayout>

<style>
  .brands-index-page {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* Observatory Hero Banner (#0B111A, #121A24, #1F2937) */
  .observatory-banner {
    position: relative;
    background: linear-gradient(135deg, #0B111A 0%, #121A24 50%, #0F1722 100%);
    border: 1px solid #1F2937;
    border-radius: var(--radius-xl);
    padding: 2.5rem 2rem;
    color: #FFFFFF;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    overflow: hidden;
