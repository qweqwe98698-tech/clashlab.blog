<script>
  // Live dynamic multi-dimensional filtering & search
  class BrandsDirectoryFilter {
    cards: HTMLElement[] = [];
    tableRows: HTMLElement[] = [];
    searchInput: HTMLInputElement | null = null;
    clearSearchBtn: HTMLButtonElement | null = null;
    resetBtn: HTMLButtonElement | null = null;
    emptyResetBtn: HTMLButtonElement | null = null;
    matchedCountElem: HTMLElement | null = null;
    noResultsView: HTMLElement | null = null;
    chipsContainer: HTMLElement | null = null;

    filters = {
      search: '',
      price: 'all',
      protocol: 'all',
      tier: 'all',
      feature: 'all'
    };

    constructor() {
      this.initElements();
      this.bindEvents();
      this.bindCouponCopy();
    }

    initElements() {
      this.cards = Array.from(document.querySelectorAll('[data-brand-card]'));
      this.tableRows = Array.from(document.querySelectorAll('[data-table-row]'));
      this.searchInput = document.getElementById('brand-search-input') as HTMLInputElement;
      this.clearSearchBtn = document.getElementById('clear-search-btn') as HTMLButtonElement;
      this.resetBtn = document.getElementById('reset-filters-btn') as HTMLButtonElement;
      this.emptyResetBtn = document.getElementById('empty-reset-btn') as HTMLButtonElement;
      this.matchedCountElem = document.getElementById('matched-count');
      this.noResultsView = document.getElementById('no-results-view');
      this.chipsContainer = document.getElementById('active-filter-chips');
    }

    bindEvents() {
      // Search input listener
      this.searchInput?.addEventListener('input', () => {
        const val = this.searchInput?.value.trim() || '';
        if (this.clearSearchBtn) {
          this.clearSearchBtn.hidden = val.length === 0;
        }
        this.filters.search = val.toLowerCase();
        this.applyFilters();
      });

      this.clearSearchBtn?.addEventListener('click', () => {
        if (this.searchInput) {
          this.searchInput.value = '';
          this.clearSearchBtn!.hidden = true;
          this.filters.search = '';
          this.applyFilters();
          this.searchInput.focus();
        }
      });

      // Filter chips click listeners
      document.querySelectorAll('[data-filter-group]').forEach((group) => {
        group.addEventListener('click', (e) => {
          const btn = (e.target as HTMLElement).closest('.filter-chip') as HTMLElement;
          if (!btn) return;
          const groupName = group.getAttribute('data-filter-group') as keyof typeof this.filters;
          const value = btn.getAttribute('data-value') || 'all';

          // Update active state in UI
          group.querySelectorAll('.filter-chip').forEach((c) => c.classList.remove('active'));
          btn.classList.add('active');

          this.filters[groupName] = value;
          this.applyFilters();
        });
      });

      // Reset button listeners
      this.resetBtn?.addEventListener('click', () => this.resetAll());
      this.emptyResetBtn?.addEventListener('click', () => this.resetAll());
    }

    applyFilters() {
      let matched = 0;

      this.cards.forEach((card) => {
        const name = (card.getAttribute('data-name') || '').toLowerCase();
        const engName = (card.getAttribute('data-english-name') || '').toLowerCase();
        const pinyin = (card.getAttribute('data-pinyin') || '').toLowerCase();
        const tags = (card.getAttribute('data-tags') || '').toLowerCase();
        const desc = (card.getAttribute('data-desc') || '').toLowerCase();
        const tagline = (card.getAttribute('data-tagline') || '').toLowerCase();
        const protocols = (card.getAttribute('data-protocols') || '').toLowerCase();
        const price = parseFloat(card.getAttribute('data-price') || '0');
        const tier = card.getAttribute('data-tier') || '';
        const hasNoExpiry = card.getAttribute('data-has-no-expiry') === 'true';
        const established = parseInt(card.getAttribute('data-established') || '2023');
        const traffic = parseInt(card.getAttribute('data-traffic') || '100');

        let isMatch = true;

        // Search text matching
        if (this.filters.search) {
          const q = this.filters.search;
          const combined = `${name} ${engName} ${pinyin} ${tags} ${desc} ${tagline} ${protocols}`;
          if (!combined.includes(q)) {
            isMatch = false;
          }
        }

        // Price dimension matching
        if (isMatch && this.filters.price !== 'all') {
          if (this.filters.price === 'p-budget' && price > 10) isMatch = false;
          if (this.filters.price === 'p-standard' && (price <= 10 || price > 20)) isMatch = false;
          if (this.filters.price === 'p-premium' && price <= 20) isMatch = false;
        }

        // Protocol dimension matching
        if (isMatch && this.filters.protocol !== 'all') {
          if (this.filters.protocol === 'vless' && !protocols.includes('vless')) isMatch = false;
          if (this.filters.protocol === 'shadowsocks' && !protocols.includes('shadowsocks')) isMatch = false;
        }

        // Tier dimension matching
        if (isMatch && this.filters.tier !== 'all') {
          if (tier !== this.filters.tier) isMatch = false;
        }

        // Feature dimension matching
        if (isMatch && this.filters.feature !== 'all') {
          if (this.filters.feature === 'ai' && !tags.includes('ai') && !desc.includes('ai') && !tagline.includes('ai')) isMatch = false;
          if (this.filters.feature === 'streaming' && !tags.includes('流媒体') && !desc.includes('netflix') && !tagline.includes('流媒体')) isMatch = false;
          if (this.filters.feature === 'traffic' && traffic < 150) isMatch = false;
          if (this.filters.feature === 'noexpiry' && !hasNoExpiry) isMatch = false;
          if (this.filters.feature === 'old' && (2026 - established < 3)) isMatch = false;
        }

        if (isMatch) {
          card.style.display = 'flex';
          matched++;
        } else {
          card.style.display = 'none';
        }
      });

      // Also filter table rows
      this.tableRows.forEach((row) => {
        const slug = row.getAttribute('data-slug') || '';
        const matchingCard = this.cards.find((c) => c.getAttribute('data-slug') === slug);
        if (matchingCard && matchingCard.style.display !== 'none') {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });

      // Update counters & empty states
      if (this.matchedCountElem) {
        this.matchedCountElem.textContent = matched.toString();
      }

      if (this.noResultsView) {
        this.noResultsView.hidden = matched > 0;
      }
    }

    resetAll() {
      if (this.searchInput) {
        this.searchInput.value = '';
        if (this.clearSearchBtn) this.clearSearchBtn.hidden = true;
      }

      this.filters = {
        search: '',
        price: 'all',
        protocol: 'all',
        tier: 'all',
        feature: 'all'
      };

      document.querySelectorAll('[data-filter-group]').forEach((group) => {
        group.querySelectorAll('.filter-chip').forEach((c) => {
          if (c.getAttribute('data-value') === 'all') {
            c.classList.add('active');
          } else {
            c.classList.remove('active');
          }
        });
      });

      this.applyFilters();
    }

    bindCouponCopy() {
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('[data-coupon]') as HTMLElement;
        if (!btn) return;
        const code = btn.getAttribute('data-coupon') || '';
        if (code) {
          navigator.clipboard.writeText(code).then(() => {
            const originalText = btn.textContent;
            btn.classList.add('copied');
            const label = btn.querySelector('.copy-label') || btn.querySelector('span') || btn;
            const prev = label.textContent;
            label.textContent = '已复制!';
            setTimeout(() => {
              label.textContent = prev;
              btn.classList.remove('copied');
            }, 1800);
          }).catch(() => {
            // fallback
          });
        }
      });
    }
  }

  if (typeof window !== 'undefined') {
    new BrandsDirectoryFilter();
  }
</script>
