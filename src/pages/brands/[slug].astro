<script>
  function initBrandPageInteractivity() {
    // 1. Coupon Copy Handlers
    const toast = document.getElementById('copy-toast');
    let toastTimeout: any;

    function showToast() {
      if (!toast) return;
      toast.classList.add('show');
      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.remove('show');
      }, 2500);
    }

    const copyButtons = document.querySelectorAll('[data-coupon]');
    copyButtons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const coupon = btn.getAttribute('data-coupon');
        if (!coupon) return;
        try {
          await navigator.clipboard.writeText(coupon);
          showToast();
          const label = btn.querySelector('.copy-btn-label');
          if (label) {
            const originalText = label.textContent;
            label.textContent = '✓ 已复制';
            setTimeout(() => {
              label.textContent = originalText;
            }, 2000);
          }
        } catch (e) {
          prompt('请手动复制优惠码：', coupon);
        }
      });
    });

    // 2. FAQ Accordion
    const faqCards = document.querySelectorAll('.faq-card');
    faqCards.forEach((card) => {
      const btn = card.querySelector('.faq-q-btn');
      btn?.addEventListener('click', () => {
        const isOpen = card.classList.contains('open');
        card.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(!isOpen));
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initBrandPageInteractivity);
  document.addEventListener('astro:page-load', initBrandPageInteractivity);
</script>
