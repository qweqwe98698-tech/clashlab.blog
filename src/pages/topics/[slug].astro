---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Badge from '../../components/common/Badge.astro';
import ConversionCTA from '../../components/article/ConversionCTA.astro';

export async function getStaticPaths() {
  let topics: any[] = [];
  try {
    topics = await getCollection('topics');
  } catch (e) {
    topics = [];
  }

  return topics.map((topic) => {
    const slug = topic.slug || topic.id.replace(/\.mdx?$/, '');
    return {
      params: { slug },
      props: { topic },
    };
  });
}

const { topic } = Astro.props;
const { Content } = await render(topic);
const topicSlug = topic.slug || topic.id.replace(/\.mdx?$/, '');

let allPosts: any[] = [];
try {
  allPosts = await getCollection('posts');
} catch (e) {
  allPosts = [];
}

// Find articles matching topic keywords
const relatedPosts = allPosts.filter((p) => {
  const title = p.data.title.toLowerCase();
  const desc = p.data.description.toLowerCase();
  const tags = (p.data.tags || []).map((t: string) => t.toLowerCase());

  if (topicSlug.includes('clash')) {
    return title.includes('clash') || tags.includes('clash');
  }
  if (topicSlug.includes('sing-box')) {
    return title.includes('sing-box') || tags.includes('sing-box');
  }
  if (topicSlug.includes('airport')) {
    return p.data.category === '机场观察' || title.includes('专线') || title.includes('机场');
  }
  if (topicSlug.includes('protocol')) {
    return p.data.category === '协议与原理' || title.includes('协议') || title.includes('dns');
  }
  if (topicSlug.includes('shadowrocket')) {
    return title.includes('shadowrocket') || title.includes('小火箭') || title.includes('ios') || tags.includes('shadowrocket');
  }
  if (topicSlug.includes('safety') || topicSlug.includes('network-safety')) {
    return p.data.category === '避坑指南' || title.includes('避坑') || title.includes('排查') || title.includes('超时');
  }
  return true;
});

const formatDate = (d: Date | string) => {
  const date = new Date(d);
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
};
---

<PageLayout
  title={topic.data.title}
  description={topic.data.description}
  tagline="TOPIC HUB"
  breadcrumbCurrent={topic.data.title}
>
  <div class="topic-detail-container">
    <!-- Topic Overview Prose -->
    <div class="card topic-overview-card">
      <div class="prose topic-intro-prose">
        <Content />
      </div>
    </div>

    <!-- Associated Articles List -->
    <section class="topic-articles-section">
      <div class="section-header">
        <div class="section-title-wrap">
          <span class="section-tag">CURATED ARTICLES</span>
          <h2 class="section-title">专题收录文章 ({relatedPosts.length} 篇)</h2>
        </div>
      </div>

      <div class="topic-posts-list">
        {relatedPosts.map((post, idx) => (
          <article class="card topic-post-item">
            <a href={`/posts/${post.slug || post.id.replace(/\.mdx?$/, '')}`} class="topic-post-link">
              <div class="post-order-index">0{idx + 1}</div>
              <div class="post-item-body">
                <div class="meta-row">
                  <Badge variant="blue" size="sm">{post.data.category}</Badge>
                  <span class="meta-dot"></span>
                  <span class="meta-item">{formatDate(post.data.pubDate)}</span>
                  <span class="meta-dot"></span>
                  <span class="meta-item">{post.data.readTime || '8 分钟'}</span>
                </div>
                <h3 class="post-item-title card-title">{post.data.title}</h3>
                <p class="post-item-desc">{post.data.description}</p>
              </div>
              <div class="post-item-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- Topic CTA -->
    <ConversionCTA
      title="准备好开始配置或加速您的网络了吗？"
      description="查阅实验室最新实测线路，结合上述配置指南，打造毫秒级低延迟通信环境。"
    />
  </div>
</PageLayout>

<style>
  .topic-detail-container {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .topic-overview-card {
    padding: 1.75rem;
    background-color: #FFFFFF;
  }

  .topic-intro-prose {
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .topic-articles-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .topic-posts-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .topic-post-item {
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .topic-post-link {
    display: flex;
    align-items: flex-start;
    padding: 1.25rem 1.5rem;
    gap: 1.25rem;
    text-decoration: none;
    color: inherit;
  }

  .post-order-index {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 1.5rem;
    font-weight: 800;
    color: #CBD5E1;
    line-height: 1;
    flex-shrink: 0;
  }

  .post-item-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .post-item-title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--text-main);
    transition: color var(--transition-fast);
  }

  .post-item-desc {
    font-size: 0.875rem;
    color: var(--text-body);
    line-height: 1.55;
  }

  .post-item-arrow {
    display: none;
    align-self: center;
    color: var(--text-muted);
  }

  @media (min-width: 640px) {
    .post-item-arrow {
      display: block;
    }
  }

  .topic-post-item:hover .post-item-arrow {
    color: var(--primary);
    transform: translateX(3px);
  }

  .post-item-arrow svg {
    width: 1.25rem;
    height: 1.25rem;
    transition: transform var(--transition-fast);
  }
</style>
