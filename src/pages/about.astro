const telemetryStats = [
  { label: '物理骨干接入', value: '5 Gbps', sub: '珠海联通骨干' },
  { label: '单节点并发线程', value: '32 线程', sub: 'TCP/UDP 满载压测' },
  { label: '晚高峰压测窗口', value: '20:00-23:00', sub: 'QoS 极限负载' },
  { label: '自动化审计内核', value: 'v2.0.0-dev', sub: 'MAI-TEST-BOT' },
  { label: '数据隔离维度', value: '4 层架构', sub: '声明/实测/商业/评测' },
];

const slaMetrics = [
  {
    name: '丢包率 (Packet Loss SLA)',
    tag: '网络连通性根基',
    golden: '< 0.5% (物理专线保障)',
    good: '0.5% - 2.0% (优质 BGP 中转)',
    warning: '> 5.0% (公网直连/超售拥堵)',
    method: '采用 32 并发流进行 300 秒持续打流，统计 TCP 重传包与 UDP 丢弃率。'
  },
  {
    name: '网络抖动 (Jitter Variance)',
    tag: '交互体验关键',
    golden: '标准差 σ < 3 ms (物理内网直连)',
    good: '3 ms ≤ σ < 10 ms (多线负载均衡)',
    warning: 'σ ≥ 15 ms (动态公网路由抢占)',
    method: '连续执行 5 组 Ping 探测，剔除首包 ARP 缓存扰动后计算 RTT 标准方差。'
  },
  {
    name: '首包延迟 (TTFB & Handshake Latency)',
    tag: '协议加解密损耗',
    golden: '< 80 ms (极速握手响应)',
    good: '80 ms - 180 ms (标准 TLS 握手)',
    warning: '> 300 ms (高延迟多跳中继)',
    method: '记录从 SYN 发起到接收 HTTP Response 首字节的纳秒级耗时，评估协议栈开销。'
  },
  {
    name: '流媒体原生 4K/8K 解锁率 (Streaming Unlock)',
    tag: '内容服务合规',
    golden: '100% 原生解锁 (无代理识别)',
    good: 'DNS 智能分流解锁 (单区原生)',
    warning: '仅自制剧 / 提示 Proxy Blocked',
    method: '自动化探测 Netflix, Disney+, YouTube Premium, Max 等主流平台 4K/8K 码率持续回放能力。'
  },
  {
    name: 'AI 低风控可用性 (AI Low-Risk Score)',
    tag: '生产力高可用',
    golden: '零人机验证 (Clean Residential/Direct ASN)',
    good: '偶发轻度验证 (优质机房 IP)',
    warning: '1020 拦截 / Access Denied / 频繁封号',
    method: '模拟长会话 Websocket 请求，评估 Cloudflare Turnstile / Arkose 验证码触发率与 IP 欺诈度评分。'
  }
];

const segregationLayers = [
  {
    layer: 'Layer 01',
    name: 'Vendor Data',
    title: '厂商数据声明层',
    color: 'blue',
    desc: '汇总服务商官方公布的公称数据，包括标称专线类型（IPLC/IEPL）、名义节点数、公称带宽上限、套餐价格与并发设备限制。',
    rules: [
      '明确标注为「厂商声明」，不作为任何实验室天梯排名的直接打分依据。',
      '定期对厂商公称规格进行物理拓扑校对，核实是否存在虚标或夸大宣传。'
    ]
  },
  {
    layer: 'Layer 02',
    name: 'Measured Data',
    title: '实验室实测证据层',
    color: 'cyan',
    desc: '基于珠海联通 5Gbps 骨干测试床在 20:00-23:00 黄金晚高峰跑出的原始证据链，包含吞吐测速图、丢包率、MTR 链路追踪与原生解锁跑分。',
    rules: [
      '所有实测数据均固化精确到秒的时间戳（CST）、测试内核版本与测速后端。',
      '保留完整无篡改的高清测速图档与链路抓包记录，支持行业公开校验。'
    ]
  },
  {
    layer: 'Layer 03',
    name: 'Commercial Data',
    title: '商业优惠与返利透明披露层',
    color: 'amber',
    desc: '全量披露厂商提供的专属优惠码折扣、推广返利（Affiliate）机制及资费性价比分析。',
    rules: [
      '100% 透明公示推广佣金机制，明确说明佣金仅用于支撑实验室服务器与 5Gbps 带宽开销。',
      '商业合作绝对不影响评分权重，严禁付费购买榜单排名或付费删除实测负面数据。'
    ]
  },
  {
    layer: 'Layer 04',
    name: 'Editorial Data',
    title: '独立中立评测与避坑建议层',
    color: 'green',
    desc: '由首席网络架构师与协议研究专家团队输出的 T1/T2/T3 梯队评级、优缺点深度剖析、场景决策树与风险警示。',
    rules: [
      '坚持「月付上车」第一原则，坚决警惕大额年付与虚假无限流量收割盘。',
      '建立动态复测与风险下架机制，一旦专线降级或丢包恶化立即全站预警。'
    ]
  }
];

