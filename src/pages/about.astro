    focus: '负责 VLESS Reality、Hysteria 2 (Brutal)、TUIC v5 等新一代协议栈审计，主导 sing-box / Mihomo 内核性能、TUN 模式及 Fake-IP 防泄漏测试。',
    skills: ['VLESS Reality', 'Hysteria 2 / QUIC', 'sing-box / Mihomo', 'DNS Leak 防护', 'TLS 握手逆向']
  },
  {
    name: 'Sarah Wu',
    title: '流媒体与 AI 应用测试主管 (Lead Streaming & AI QA)',
    avatar: 'SW',
    badge: 'AI风控 & 流媒体矩阵',
    bio: '8 年跨国出海应用全链路测试工程师，持续跟踪 OpenAI (ChatGPT)、Anthropic (Claude) 以及 Netflix、Disney+ 等全球边缘服务风控机制。',
    focus: '主持流媒体 4K/8K 原生解锁矩阵、住宅 IP 纯净度检测（IPQS / Spur）与生产级 AI 长会话低风控测试体系。',
    skills: ['OpenAI / Claude 风控', 'Cloudflare Turnstile 绕过', 'Netflix 4K/8K 解锁', '住宅/机房 IP 纯净度', 'Websocket 长连接']
  }
];

const editorialPrinciples = [
  {
    num: '01',
    title: '坚守「月付上车」第一原则 (Monthly Subscription First)',
    desc: '跨境网络基础设施受机房网络政策、上游运营商结算、入口 IP 阻断以及服务商资金链等多重不可控因素影响。ClashLab 始终告诫用户绝不轻易购买长周期年付，优先选择月付以将试错成本控制在最低，保持主动切换的权利。'
  },
  {
    num: '02',
    title: '零容忍商业赞助操纵 (Zero-Tolerance Sponsored Reviews)',
    desc: '我们绝不接受任何付费定制好评，绝不接受厂商花钱删除负面测试数据（如晚高峰断流、虚假 IPLC 专线欺诈）。所有评测结论均必须基于可复现的抓包证据与真实测速图档。'
  },
  {
    num: '03',
    title: '商业返利与资金流向 100% 透明 (Affiliate Transparency)',
    desc: 'ClashLab 参与部分服务商的公开推广返利计划。所得收益全部反哺于实验室 5Gbps 骨干专线宽带采购、多节点测速探针服务器托管与高并发测试脚本研发，与评测打分机制完全解耦。'
  },
  {
    num: '04',
    title: '持续动态复测与下架预警机制 (Continuous Audit & Delisting)',
    desc: '网络服务具有动态时变特性。ClashLab 建立常态化周期性复测机制。若某服务商发生严重超售、断流率持续攀升或出现跑路征兆，编辑部将立即降级其梯队并在全站高亮风险预警，直至强制下架。'
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Schema.org JSON-LD Structured Data for E-E-A-T -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="about-page-wrapper">
    
    <!-- Hero Banner Section (#0B111A / Dark Tech Surface) -->
    <header class="about-hero-section">
      <div class="container hero-container">
        <!-- Breadcrumbs -->
        <nav class="about-breadcrumbs" aria-label="路径导航">
          <a href="/">首页</a>
          <span class="crumb-sep">/</span>
          <span class="crumb-current">关于实验室 (E-E-A-T &amp; 方法论)</span>
        </nav>

        <div class="hero-tag-wrap">
          <Badge variant="blue" dot>E-E-A-T SPECIFICATION &amp; METHODOLOGY</Badge>
          <span class="hero-version-tag">2026-08 实验室权威实测标准</span>
        </div>

        <h1 class="hero-main-title">
          推动网络协议透明度 <br class="hidden-mobile" />
          <span class="gradient-text">&amp; 跨境网络基础设施可观测性</span>
        </h1>

        <p class="hero-main-desc">
          <strong>ClashLab (clashlab.blog)</strong> 是专注于现代网络代理协议演进、主流客户端架构（Clash Verge Rev / sing-box / Shadowrocket）与全球跨境网络基础设施深度基准测试的独立技术实验室。
        </p>

        <!-- Key Telemetry Stats Strip -->
        <div class="hero-telemetry-grid">
          {telemetryStats.map((item) => (
            <div class="telemetry-box">
              <span class="telemetry-label">{item.label}</span>
              <span class="telemetry-value">{item.value}</span>
              <span class="telemetry-sub">{item.sub}</span>
            </div>
          ))}
        </div>

        <!-- Quick Section Anchor Links -->
        <nav class="about-anchor-nav" aria-label="内容快速跳转">
          <span class="anchor-label">快速导航：</span>
          <a href="#mission" class="anchor-link">核心使命</a>
          <a href="#methodology" class="anchor-link">SLA 测试方法论</a>
          <a href="#data-segregation" class="anchor-link">四层数据隔离</a>
          <a href="#expert-team" class="anchor-link">E-E-A-T 专家团队</a>
          <a href="#editorial-policy" class="anchor-link">编辑独立性政策</a>
          <a href="#contact" class="anchor-link">联系与测速提交</a>
        </nav>
      </div>
    </header>

    <!-- Main Content Sections Container -->
    <div class="container about-main-body">

      <!-- Section 1: Core Mission & Philosophy -->
      <section id="mission" class="about-content-block">
        <div class="section-header">
          <div class="section-title-wrap">
            <span class="section-tag">CORE MISSION &amp; VISION</span>
            <h2 class="section-title">实验室核心使命与创立愿景</h2>
          </div>
        </div>

        <div class="card mission-card">
          <div class="mission-text-grid">
            <div class="mission-text-col">
              <h3 class="mission-subheading">打破跨境网络领域的黑箱与信息差</h3>
              <p class="mission-paragraph">
                跨境网络服务行业长期充斥着大量虚假宣传、公网隧道冒充专线（Fake IPLC/IEPL）、超售导致的晚高峰严重丢包断流以及诱导年付导致的跑路风险。普通用户与出海技术团队往往面临极高的信息不对称与试错成本。
              </p>
              <p class="mission-paragraph">
                <strong>ClashLab 实验室</strong>应运而生。我们秉持实证主义（Evidence-Based）与网络测量工程学原则，通过部署在骨干网边缘的真实硬件探针，对网络协议、中转隧道、落地纯净度与流媒体/AI 访问可用性进行不间断的主动拨测与全负载压力测试。
              </p>
            </div>
            <div class="mission-text-col">
              <h3 class="mission-subheading">实证科学驱动的 E-E-A-T 权威体系</h3>
              <p class="mission-paragraph">
                我们拒绝浮于表面的主观推荐，深入到 TCP/UDP 传输协议栈、TUN 虚拟网卡实现、BBR/Brutal 拥塞控制与 TLS 握手特征底层。
              </p>
              <div class="mission-highlights-box">
                <div class="highlight-item">
                  <span class="h-icon">🔬</span>
                  <div>
                    <strong>经验与专业 (Experience &amp; Expertise)：</strong> 12 年跨国 ISP 骨干运维与协议逆向团队全职把关。
                  </div>
                </div>
                <div class="highlight-item">
                  <span class="h-icon">🛡️</span>
                  <div>
                    <strong>权威与信任 (Authoritativeness &amp; Trustworthiness)：</strong> 完整可复现的数据证据链，100% 独立中立客观立场。
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Testing Methodology & SLA Standards -->
      <section id="methodology" class="about-content-block">
        <div class="section-header">
          <div class="section-title-wrap">
            <span class="section-tag">TESTING METHODOLOGY &amp; SLA BENCHMARK</span>
