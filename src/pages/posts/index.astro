---
import PageLayout from '../../layouts/PageLayout.astro';
import Badge from '../../components/common/Badge.astro';
import { getCollection } from 'astro:content';

let posts: any[] = [];
try {
  posts = await getCollection('posts');
  posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
} catch (e) {
  posts = [];
}

const categories = ['全部', '客户端教程', '协议与原理', '机场观察', '避坑指南'];

const formatDate = (d: Date | string) => {
  const date = new Date(d);
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
};
---

<PageLayout
  title="文章知识库"
  description="收录 ClashLab 实验室全部原创技术指南、客户端实战配置、网络协议原理拆解与机场客观评测。"
  tagline="ARTICLE ARCHIVE"
  breadcrumbCurrent="全部文章"
>
  <div class="posts-page-container">
    <!-- Category & Filter Bar -->
    <div class="posts-filter-bar">
      <div class="categories-cluster" id="category-filter">
        {categories.map((cat, idx) => (
          <button
            class={`category-filter-btn ${idx === 0 ? 'active' : ''}`}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <div class="posts-counter">
        共 <strong id="visible-count">{posts.length}</strong> 篇技术研究
      </div>
    </div>

    <!-- Posts Grid -->
    <div class="posts-grid" id="posts-grid">
      {posts.map((post) => (
        <article class="card post-archive-card" data-cat={post.data.category} data-tags={JSON.stringify(post.data.tags || [])}>
          <a href={`/posts/${post.slug || post.id}`} class="post-archive-link">
            <!-- Card Top Header -->
            <div class="archive-card-top">
              <Badge variant={
                post.data.category === '客户端教程' ? 'blue' :
                post.data.category === '机场观察' ? 'green' :
                post.data.category === '协议与原理' ? 'dark' : 'amber'
              } size="sm">
                {post.data.category}
              </Badge>
              <span class="archive-date">{formatDate(post.data.pubDate)}</span>
            </div>

            <!-- Card Title & Excerpt -->
            <h2 class="archive-title card-title">{post.data.title}</h2>
            <p class="archive-desc">{post.data.description}</p>

            <!-- Card Tags -->
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="archive-tags">
                {post.data.tags.slice(0, 3).map((t: string) => (
                  <span class="archive-tag-pill">#{t}</span>
                ))}
              </div>
            )}

            <!-- Footer -->
            <div class="archive-footer">
              <span class="archive-read-time">{post.data.readTime || '8 分钟阅读'}</span>
              <span class="archive-arrow">
                阅读文章
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </div>
          </a>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    <div id="no-results" class="no-results-box" style="display: none;">
      <p>该分类下暂无文章，请切换其他分类浏览。</p>
    </div>
  </div>
</PageLayout>

<style>
  .posts-page-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .posts-filter-bar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-light);
  }

  @media (min-width: 640px) {
    .posts-filter-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .categories-cluster {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .category-filter-btn {
    padding: 0.4rem 0.875rem;
    font-size: 0.84375rem;
    font-weight: 500;
    border-radius: var(--radius-sm);
    background-color: var(--bg-aux);
    border: 1px solid var(--border-light);
    color: var(--text-body);
    transition: all var(--transition-fast);
  }

  .category-filter-btn:hover {
    background-color: #E2E8F0;
    color: var(--text-main);
  }

  .category-filter-btn.active {
    background-color: var(--primary);
    border-color: var(--primary);
    color: #FFFFFF;
    font-weight: 600;
  }

  .posts-counter {
    font-size: 0.84375rem;
    color: var(--text-muted);
  }

  .posts-counter strong {
    color: var(--primary);
  }

  /* Grid Layout */
  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .post-archive-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .post-archive-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    gap: 0.75rem;
  }

  .archive-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .archive-date {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .archive-title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text-main);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--transition-fast);
  }

  .archive-desc {
    font-size: 0.84375rem;
    color: var(--text-body);
    line-height: 1.55;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .archive-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .archive-tag-pill {
    font-size: 0.6875rem;
    color: var(--text-muted);
    background-color: var(--bg-aux);
    border: 1px solid var(--border-light);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }

  .archive-footer {
    margin-top: auto;
    padding-top: 0.875rem;
    border-top: 1px solid var(--border-light);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .archive-read-time {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .archive-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--primary);
    transition: transform var(--transition-fast);
  }

  .post-archive-card:hover .archive-arrow {
    transform: translateX(3px);
  }

  .archive-arrow svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  .no-results-box {
    padding: 4rem 2rem;
    text-align: center;
    background-color: var(--bg-aux);
    border-radius: var(--radius-md);
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
</style>

<script>
  function initPostFiltering() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.category-filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.post-archive-card');
    const counter = document.getElementById('visible-count');
    const noResults = document.getElementById('no-results');

    // Parse URL parameter if present
    const urlParams = new URLSearchParams(window.location.search);
    const categoryParam = urlParams.get('category');
    const tagParam = urlParams.get('tag');

    function applyFilter(cat: string, tag?: string | null) {
      let count = 0;
      cards.forEach((card) => {
        const cardCat = card.getAttribute('data-cat') || '';
        const cardTags = JSON.parse(card.getAttribute('data-tags') || '[]');

        const matchCat = cat === '全部' || cardCat === cat;
        const matchTag = !tag || cardTags.includes(tag);

        if (matchCat && matchTag) {
          card.style.display = 'flex';
          count++;
        } else {
          card.style.display = 'none';
        }
      });

      if (counter) counter.textContent = String(count);
      if (noResults) {
        noResults.style.display = count === 0 ? 'block' : 'none';
      }
    }

    if (categoryParam) {
      filterBtns.forEach((btn) => {
        if (btn.getAttribute('data-category') === categoryParam) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
      applyFilter(categoryParam);
    } else if (tagParam) {
      applyFilter('全部', tagParam);
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const cat = btn.getAttribute('data-category') || '全部';
        applyFilter(cat);
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initPostFiltering);
  document.addEventListener('astro:page-load', initPostFiltering);
</script>
